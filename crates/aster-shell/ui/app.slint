// The Aster Office main window: tab strip, toolbar, sidebar, document area and
// status bar. Everything here is chrome; the document area of a Writer tab is
// one image that the Rust side draws itself, and Slint only forwards input to it.
// A Markdown tab has up to two: the source and the preview.

import { Tokens, Icons, Strings, TabItem, ToolItem, KindItem, RecentItem, TreeItem, RecoveryItem } from "tokens.slint";
import { TabStrip } from "tabstrip.slint";
import { Toolbar } from "toolbar.slint";
import { Sidebar } from "sidebar.slint";
import { StartPage } from "start.slint";
import { Placeholder } from "placeholder.slint";
import { StatusBar } from "statusbar.slint";
import { AssistantPanel } from "assistant.slint";
import { Dialog } from "dialog.slint";
import { RecoveryDialog } from "recovery.slint";
import { Hairline } from "widgets.slint";
import { FindBar } from "findbar.slint";

export { Tokens, Icons, Strings }

export component AppWindow inherits Window {
    title: root.active-title == "" ? "Aster Office" : root.active-title + " — Aster Office";
    // Window and taskbar icon on Windows and X11. macOS takes the Dock icon from
    // the bundle and Wayland from the desktop entry, so this does nothing there.
    icon: @image-url("../../../assets/brand/logo/png/aster-icon-256.png");
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 420px;
    background: Tokens.surface;
    default-font-size: Tokens.font-md;

    in property <[TabItem]> tabs;
    // -1 while the start page is showing.
    in property <int> active-index: -1;
    // Kind of the document in front, -1 on the start page.
    in property <int> active-kind: -1;
    in property <string> active-title;
    in property <string> placeholder-title;
    in property <string> placeholder-plan;
    in property <[ToolItem]> toolbar-items;
    in property <[KindItem]> kinds;
    // Every recent file, for the start page.
    in property <[RecentItem]> recent;
    // The few the sidebar lists, or every match while it filters.
    in property <[RecentItem]> sidebar-recent;
    in property <[TreeItem]> tree;
    // The folder shown in the sidebar; empty while none is open.
    in property <string> folder-name;
    in-out property <string> sidebar-filter;
    in property <bool> sidebar-filtering;
    // The document in front has a file on disk.
    in property <bool> current-has-file;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> assistant-open;
    in property <[string]> languages;
    in property <int> language-index;
    // Room for the window buttons where the tab strip doubles as the title bar.
    in property <length> leading-inset;

    // The tab in front is a document that can be edited, saved and undone.
    in property <bool> editing;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // 0 while no question is open; see dialog.slint for the kinds.
    in property <int> dialog-kind;
    in property <string> dialog-title;
    in property <string> dialog-body;
    // Documents a crash left unsaved; the question is shown while any remain.
    in property <[RecoveryItem]> recovery-items;

    in property <string> status-kind;
    in property <string> status-note;
    in property <string> status-words;
    in property <string> status-chars;
    in property <string> status-format;
    in property <string> status-notice;
    in property <string> status-ime;
    in property <bool> status-composing;
    in property <string> status-zoom;
    in property <bool> zoom-enabled;

    // The frame the Rust side rendered for the document surface.
    in property <image> frame;
    // Scroll position of the surface, for the scroll indicator.
    in property <length> scroll-offset;
    in property <length> scroll-max;

    // How a Markdown tab shows its document: 0 the source, 1 source and
    // preview side by side, 2 the preview. Always 0 for other tabs.
    in property <int> view-mode;
    in property <image> preview-frame;
    in property <length> preview-scroll-offset;
    in property <length> preview-scroll-max;
    // The pointer is over a link in the preview.
    in property <bool> preview-link-hover;
    // Shown in the preview pane instead of a preview, such as for a document
    // too large to preview.
    in property <string> preview-note;

    // The find bar of the Markdown tab in front.
    in property <bool> find-open;
    in property <bool> find-replace;
    in-out property <string> find-query;
    in-out property <string> find-replacement;
    in property <string> find-position;
    in property <bool> find-error;
    in property <bool> find-case;
    in property <bool> find-whole;
    in property <bool> find-regex;
    in property <bool> find-busy;

    // Geometry the Rust side needs to size its buffer and place the candidate window.
    out property <length> surface-width: editor-pane.width;
    out property <length> surface-height: editor-pane.height;
    out property <length> surface-x: editor-pane.absolute-position.x;
    out property <length> surface-y: editor-pane.absolute-position.y;
    out property <bool> surface-focused: scope.has-focus;
    out property <length> preview-width: preview-pane.width;
    out property <length> preview-height: preview-pane.height;
    // Writer and Markdown tabs both show the custom-drawn surface.
    property <bool> surface-active: root.active-kind == 0 || root.active-kind == 3;

    callback tab-activate(int);
    callback tab-close(int);
    callback new-document(int);
    callback show-start();
    // 0 open, 1 show in the file manager, 2 take off the list; from the
    // sidebar's short list or the start page's full one.
    callback recent-action(int, bool, int);
    callback clear-recent();
    // 0 open or expand, 1 show in the file manager.
    callback tree-action(int, int);
    callback open-folder();
    callback refresh-folder();
    callback reveal-current();
    callback sidebar-filter-edited(string);
    callback toggle-theme();
    callback set-language(int);
    callback toolbar-command(int);
    callback file-new();
    callback file-open();
    callback file-save();
    callback file-save-as();
    callback file-close();
    callback quit-requested();
    callback edit-undo();
    callback edit-redo();
    callback edit-cut();
    callback edit-copy();
    callback edit-paste();
    callback edit-select-all();
    callback dialog-save();
    callback dialog-discard();
    callback dialog-cancel();
    callback recovery-restore(int);
    callback recovery-discard(int);
    callback recovery-restore-all();
    callback recovery-later();
    callback zoom-out();
    callback zoom-reset();
    callback zoom-in();
    callback drag-window();
    callback toggle-maximize();
    // text, shift, primary (Cmd on macOS, Ctrl elsewhere), alt. Returns true when handled.
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback pointer-down(length, length, bool);
    callback pointer-drag(length, length);
    callback scrolled(length);
    callback preview-scrolled(length);
    callback find-query-edited(string);
    callback find-replacement-edited(string);
    callback find-next();
    callback find-previous();
    callback find-close();
    // 0 case, 1 whole word, 2 regular expression.
    callback find-toggle(int);
    callback replace-one();
    callback replace-all();
    callback menu-find();
    callback menu-replace();
    callback menu-find-selection();
    callback preview-clicked(length, length);
    callback preview-moved(length, length);
    // A press in the preview starts a selection (with Shift, extends it);
    // moving with the button down drags it.
    callback preview-pressed(length, length, bool);
    callback preview-dragged(length, length);

    // Give the keyboard to the document surface.
    public function focus-document() {
        // With the preview alone on screen, the keyboard scrolls it.
        if (root.view-mode == 2) {
            preview-scope.focus();
        } else {
            scope.focus();
        }
    }

    public function focus-find-query() {
        findbar.focus-query();
    }

    // Slint has no clipboard API for application code, but its text input can
    // copy and paste. This one is never shown; it only carries text to and from
    // the system clipboard. It belongs in aster-platform once that has a
    // clipboard of its own.
    public function copy-to-clipboard(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }

    public function clipboard-text() -> string {
        clipboard.text = "";
        clipboard.paste();
        return clipboard.text;
    }

    clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        single-line: false;
    }

    MenuBar {
        Menu {
            title: Strings.menu-file;
            MenuItem {
                title: Strings.menu-new-markdown;
                shortcut: @keys(Control + N);
                activated => {
                    root.file-new();
                }
            }

            MenuItem {
                title: Strings.menu-open;
                shortcut: @keys(Control + O);
                activated => {
                    root.file-open();
                }
            }

            MenuItem {
                title: Strings.menu-open-folder;
                shortcut: @keys(Control + Shift + O);
                activated => {
                    root.open-folder();
                }
            }

            MenuItem {
                title: Strings.menu-clear-recent;
                activated => {
                    root.clear-recent();
                }
            }

            MenuItem {
                title: Strings.reveal;
                enabled: root.current-has-file;
                activated => {
                    root.reveal-current();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-save;
                shortcut: @keys(Control + S);
                enabled: root.editing;
                activated => {
                    root.file-save();
                }
            }

            MenuItem {
                title: Strings.menu-save-as;
                shortcut: @keys(Control + Shift + S);
                enabled: root.editing;
                activated => {
                    root.file-save-as();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-close-tab;
                shortcut: @keys(Control + W);
                enabled: root.active-index >= 0;
                activated => {
                    root.file-close();
                }
            }

            MenuItem {
                title: Strings.menu-quit;
                role: quit;
                activated => {
                    root.quit-requested();
                }
            }
        }

        Menu {
            title: Strings.menu-edit;
            MenuItem {
                title: Strings.menu-undo;
                shortcut: @keys(Control + Z);
                enabled: findbar.editing-text || (root.editing && root.can-undo);
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(4);
                    } else {
                        root.edit-undo();
                    }
                }
            }

            MenuItem {
                title: Strings.menu-redo;
                shortcut: @keys(Control + Shift + Z);
                enabled: findbar.editing-text || (root.editing && root.can-redo);
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(5);
                    } else {
                        root.edit-redo();
                    }
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-cut;
                shortcut: @keys(Control + X);
                enabled: root.editing;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(1);
                    } else {
                        root.edit-cut();
                    }
                }
            }

            MenuItem {
                title: Strings.menu-copy;
                shortcut: @keys(Control + C);
                enabled: root.editing;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(2);
                    } else {
                        root.edit-copy();
                    }
                }
            }

            MenuItem {
                title: Strings.menu-paste;
                shortcut: @keys(Control + V);
                enabled: root.editing;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(3);
                    } else {
                        root.edit-paste();
                    }
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-select-all;
                shortcut: @keys(Control + A);
                enabled: root.surface-active;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(0);
                    } else {
                        root.edit-select-all();
                    }
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-find;
                shortcut: @keys(Control + F);
                enabled: root.editing;
                activated => {
                    root.menu-find();
                }
            }

            MenuItem {
                title: Strings.menu-find-next;
                shortcut: @keys(Control + G);
                enabled: root.editing;
                activated => {
                    root.find-next();
                }
            }

            MenuItem {
                title: Strings.menu-find-previous;
                shortcut: @keys(Control + Shift + G);
                enabled: root.editing;
                activated => {
                    root.find-previous();
                }
            }

            MenuItem {
                title: Strings.menu-find-selection;
                shortcut: @keys(Control + E);
                enabled: root.editing;
                activated => {
                    root.menu-find-selection();
                }
            }

            MenuItem {
                title: Strings.menu-replace;
                shortcut: @keys(Control + Alt + F);
                enabled: root.editing;
                activated => {
                    root.menu-replace();
                }
            }
        }
    }

    VerticalLayout {
        TabStrip {
            tabs: root.tabs;
            active-index: root.active-index;
            kinds: root.kinds;
            leading-inset: root.leading-inset;
            sidebar-open: root.sidebar-open;
            assistant-open: root.assistant-open;
            languages: root.languages;
            language-index: root.language-index;
            activate(index) => {
                root.tab-activate(index);
            }
            close(index) => {
                root.tab-close(index);
            }
            new-document(kind) => {
                root.new-document(kind);
            }
            show-start => {
                root.show-start();
            }
            toggle-sidebar => {
                root.sidebar-open = !root.sidebar-open;
            }
            toggle-theme => {
                root.toggle-theme();
            }
            toggle-assistant => {
                root.assistant-open = !root.assistant-open;
            }
            set-language(index) => {
                root.set-language(index);
            }
            drag-window => {
                root.drag-window();
            }
            toggle-maximize => {
                root.toggle-maximize();
            }
        }

        Hairline { }

        HorizontalLayout {
            vertical-stretch: 1;

            Sidebar {
                width: root.sidebar-open ? Tokens.sidebar-width : 0px;
                animate width {
                    duration: 140ms;
                    easing: ease-out;
                }
                recent: root.sidebar-recent;
                tree: root.tree;
                folder-name: root.folder-name;
                filtering: root.sidebar-filtering;
                filter <=> root.sidebar-filter;
                filter-edited(text) => {
                    root.sidebar-filter-edited(text);
                }
                open-recent(index) => {
                    root.recent-action(0, true, index);
                }
                reveal-recent(index) => {
                    root.recent-action(1, true, index);
                }
                remove-recent(index) => {
                    root.recent-action(2, true, index);
                }
                clear-recent => {
                    root.clear-recent();
                }
                tree-clicked(index) => {
                    root.tree-action(0, index);
                }
                reveal-tree(index) => {
                    root.tree-action(1, index);
                }
                open-folder => {
                    root.open-folder();
                }
                refresh => {
                    root.refresh-folder();
                }
            }

            // The toolbar belongs to the document: it sits over the document
            // area only, so the sidebar does not move when the first
            // document opens.
            VerticalLayout {
                horizontal-stretch: 1;
                if root.active-kind >= 0: Toolbar {
                    items: root.toolbar-items;
                    command(id) => {
                        root.toolbar-command(id);
                    }
                }

                content := Rectangle {
                    vertical-stretch: 1;
                    background: Tokens.desk;
                    clip: true;

                    findbar := FindBar {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        visible: root.find-open && root.active-kind == 3;
                        replace-visible: root.find-replace;
                        query <=> root.find-query;
                        replacement <=> root.find-replacement;
                        position: root.find-position;
                        error: root.find-error;
                        match-case: root.find-case;
                        whole-word: root.find-whole;
                        use-regex: root.find-regex;
                        busy: root.find-busy;
                        query-edited(text) => {
                            root.find-query-edited(text);
                        }
                        replacement-edited(text) => {
                            root.find-replacement-edited(text);
                        }
                        next => {
                            root.find-next();
                        }
                        previous => {
                            root.find-previous();
                        }
                        close => {
                            root.find-close();
                        }
                        toggle(option) => {
                            root.find-toggle(option);
                        }
                        replace-one => {
                            root.replace-one();
                        }
                        replace-all => {
                            root.replace-all();
                        }
                    }

                    // Always present so its size is known before the first Writer
                    // tab opens; other views are stacked on top of it.
                    surface := Rectangle {
                        y: findbar.visible ? findbar.height : 0px;
                        height: parent.height - self.y;
                        visible: root.surface-active;
                        // The source takes the whole width, the left half, or
                        // nothing; the preview the rest, after a hairline.
                        property <length> editor-width: root.view-mode == 0 ? self.width : root.view-mode == 1 ? round((self.width - 1px) / 2 / 1px) * 1px : 0px;

                        editor-pane := Rectangle {
                            x: 0;
                            width: parent.editor-width;
                            height: parent.height;
                            clip: true;

                            // The frames are drawn at the pane's size; their pixel
                            // size must not feed back into the window's layout.
                            Image {
                                source: root.frame;
                                width: 100%;
                                height: 100%;
                                preferred-width: 0px;
                                preferred-height: 0px;
                                image-fit: fill;
                                visible: root.view-mode != 2;
                            }

                            scope := FocusScope {
                                enabled: root.surface-active;
                                key-pressed(event) => {
                                    return root.key-pressed(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt) ? accept : reject;
                                }

                                TouchArea {
                                    enabled: root.surface-active && root.view-mode != 2;
                                    mouse-cursor: text;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            scope.focus();
                                            root.pointer-down(self.mouse-x, self.mouse-y, event.modifiers.shift);
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.pointer-drag(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    scroll-event(event) => {
                                        root.scrolled(event.delta-y);
                                        return accept;
                                    }
                                }
                            }

                            // Shows where the view is in the document. Not draggable yet.
                            if root.scroll-max > 0 && root.view-mode != 2: Rectangle {
                                property <length> track: parent.height - 2 * Tokens.space-xs;
                                property <length> thumb: max(32px, self.track * (parent.height / (parent.height + root.scroll-max)));
                                x: parent.width - self.width - 3px;
                                y: Tokens.space-xs + (self.track - self.thumb) * (root.scroll-offset / root.scroll-max);
                                width: 6px;
                                height: self.thumb;
                                border-radius: 3px;
                                background: Tokens.text-disabled;
                            }
                        }

                        if root.view-mode == 1: Rectangle {
                            x: parent.editor-width;
                            width: 1px;
                            height: parent.height;
                            background: Tokens.hairline;
                        }

                        preview-pane := Rectangle {
                            x: root.view-mode == 1 ? parent.editor-width + 1px : 0px;
                            width: root.view-mode == 0 ? 0px : parent.width - self.x;
                            height: parent.height;
                            clip: true;
                            visible: root.view-mode != 0;

                            Image {
                                source: root.preview-frame;
                                width: 100%;
                                height: 100%;
                                preferred-width: 0px;
                                preferred-height: 0px;
                                image-fit: fill;
                            }

                            // Keys while the preview was clicked last, or is on
                            // screen alone: scrolling, select all, copy.
                            preview-scope := FocusScope {
                                enabled: root.surface-active && root.view-mode != 0;
                                key-pressed(event) => {
                                    return root.key-pressed(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt) ? accept : reject;
                                }
                            }

                            TouchArea {
                                enabled: root.surface-active && root.view-mode != 0;
                                mouse-cursor: root.preview-link-hover ? pointer : text;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        preview-scope.focus();
                                        root.preview-pressed(self.mouse-x, self.mouse-y, event.modifiers.shift);
                                    }
                                }
                                clicked => {
                                    root.preview-clicked(self.mouse-x, self.mouse-y);
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.preview-dragged(self.mouse-x, self.mouse-y);
                                    } else {
                                        root.preview-moved(self.mouse-x, self.mouse-y);
                                    }
                                }
                                scroll-event(event) => {
                                    root.preview-scrolled(event.delta-y);
                                    return accept;
                                }
                            }

                            if root.preview-note != "": Text {
                                x: Tokens.space-xl;
                                width: parent.width - 2 * Tokens.space-xl;
                                height: parent.height;
                                text: root.preview-note;
                                color: Tokens.text-secondary;
                                font-size: Tokens.font-md;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            if root.preview-scroll-max > 0: Rectangle {
                                property <length> track: parent.height - 2 * Tokens.space-xs;
                                property <length> thumb: max(32px, self.track * (parent.height / (parent.height + root.preview-scroll-max)));
                                x: parent.width - self.width - 3px;
                                y: Tokens.space-xs + (self.track - self.thumb) * (root.preview-scroll-offset / root.preview-scroll-max);
                                width: 6px;
                                height: self.thumb;
                                border-radius: 3px;
                                background: Tokens.text-disabled;
                            }
                        }
                    }

                    if root.active-kind > 0 && root.active-kind != 3: Placeholder {
                        kind: root.active-kind;
                        title: root.placeholder-title;
                        plan: root.placeholder-plan;
                    }

                    if root.active-kind < 0: StartPage {
                        kinds: root.kinds;
                        recent: root.recent;
                        new-document(kind) => {
                            root.new-document(kind);
                        }
                        open-recent(index) => {
                            root.recent-action(0, false, index);
                        }
                        reveal-recent(index) => {
                            root.recent-action(1, false, index);
                        }
                        remove-recent(index) => {
                            root.recent-action(2, false, index);
                        }
                        clear-recent => {
                            root.clear-recent();
                        }
                        open-file => {
                            root.file-open();
                        }
                        open-folder => {
                            root.open-folder();
                        }
                    }
                }
            }

            AssistantPanel {
                width: root.assistant-open ? self.panel-width : 0px;
                animate width {
                    duration: 140ms;
                    easing: ease-out;
                }
            }
        }

        StatusBar {
            kind-label: root.status-kind;
            note: root.status-note;
            words: root.status-words;
            chars: root.status-chars;
            file-format: root.status-format;
            notice: root.status-notice;
            ime-label: root.status-ime;
            ime-composing: root.status-composing;
            zoom-label: root.status-zoom;
            zoom-enabled: root.zoom-enabled;
            zoom-out => {
                root.zoom-out();
            }
            zoom-reset => {
                root.zoom-reset();
            }
            zoom-in => {
                root.zoom-in();
            }
        }
    }

    if root.recovery-items.length > 0: RecoveryDialog {
        items: root.recovery-items;
        restore(index) => {
            root.recovery-restore(index);
        }
        discard(index) => {
            root.recovery-discard(index);
        }
        restore-all => {
            root.recovery-restore-all();
        }
        later => {
            root.recovery-later();
        }
    }

    // After the recovery question, so a message raised while it is open
    // appears on top of it.
    if root.dialog-kind != 0: Dialog {
        kind: root.dialog-kind;
        title: root.dialog-title;
        body: root.dialog-body;
        save => {
            root.dialog-save();
        }
        discard => {
            root.dialog-discard();
        }
        cancel => {
            root.dialog-cancel();
        }
    }
}
