        // Markdown syntax written for the user; only with the source on
        // screen. Shortcuts as in Typora.
        Menu {
            title: Strings.menu-format;

            MenuItem {
                title: Strings.format-bold;
                checked: (root.formatting && root.mark-bold) || (root.sheet-formatting && root.cell-bold);
                shortcut: @keys(Control + B);
                enabled: root.formatting || root.sheet-formatting;
                activated => {
                    if (root.sheet-formatting) {
                        root.sheet-format(0);
                    } else {
                        root.format(0);
                    }
                }
            }

            MenuItem {
                title: Strings.format-italic;
                checked: (root.formatting && root.mark-italic) || (root.sheet-formatting && root.cell-italic);
                shortcut: @keys(Control + I);
                enabled: root.formatting || root.sheet-formatting;
                activated => {
                    if (root.sheet-formatting) {
                        root.sheet-format(1);
                    } else {
                        root.format(1);
                    }
                }
            }

            // Markdown has no underline; workbooks do.
            MenuItem {
                title: Strings.format-underline;
                checked: root.sheet-formatting && root.cell-underline;
                shortcut: @keys(Control + U);
                enabled: root.sheet-formatting;
                activated => {
                    root.sheet-format(2);
                }
            }

            MenuItem {
                title: Strings.format-strike;
                checked: (root.formatting && root.mark-strike) || (root.sheet-formatting && root.cell-strike);
                shortcut: @keys(Control + Shift + X);
                enabled: root.formatting || root.sheet-formatting;
                activated => {
                    if (root.sheet-formatting) {
                        root.sheet-format(3);
                    } else {
                        root.format(2);
                    }
                }
            }

            MenuItem {
                title: Strings.format-code;
                checked: root.formatting && root.mark-code;
