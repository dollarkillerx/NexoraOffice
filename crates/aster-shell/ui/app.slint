            MenuItem {
                title: Strings.format-image;
                enabled: root.formatting;
                activated => {
                    root.format(9);
                }
            }

            MenuItem {
                title: Strings.format-table;
                shortcut: @keys(Control + Alt + T);
                enabled: root.formatting;
                activated => {
                    root.format(10);
                }
            }

            MenuItem {
                title: Strings.format-rule;
                enabled: root.formatting;
                activated => {
                    root.format(12);
                }
            }

            MenuItem {
                title: Strings.format-toc;
                enabled: root.formatting;
                activated => {
                    root.format(13);
                }
            }

            MenuItem {
                title: Strings.format-footnote;
                enabled: root.formatting;
                activated => {
                    root.format(14);
                }
            }

            // Rows and columns of the table with the caret; greyed out
            // elsewhere.
            Menu {
                title: Strings.table-edit;

                MenuItem {
                    title: Strings.table-row-above;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(30);
                    }
                }

                MenuItem {
                    title: Strings.table-row-below;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(31);
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: Strings.table-column-left;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(32);
                    }
                }

                MenuItem {
                    title: Strings.table-column-right;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(33);
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: Strings.table-delete-row;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(34);
                    }
                }

                MenuItem {
                    title: Strings.table-delete-column;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(35);
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: Strings.table-align-left;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(36);
                    }
                }

                MenuItem {
                    title: Strings.table-align-center;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(37);
                    }
                }

                MenuItem {
                    title: Strings.table-align-right;
                    enabled: root.formatting && root.in-table;
                    activated => {
                        root.format(38);
                    }
                }
            }

            MenuSeparator { }

            MenuItem {
                // No Cmd+0: Writer tabs reset the zoom with it.
                title: root.heading-names[0];
                checked: root.formatting && root.mark-heading == 0;
                enabled: root.formatting;
                activated => {
                    root.format(20);
                }
            }

            MenuItem {
                title: root.heading-names[1];
                checked: root.formatting && root.mark-heading == 1;
                shortcut: @keys(Control + "1");
                enabled: root.formatting;
                activated => {
                    root.format(21);
                }
            }

            MenuItem {
                title: root.heading-names[2];
                checked: root.formatting && root.mark-heading == 2;
                shortcut: @keys(Control + "2");
                enabled: root.formatting;
                activated => {
                    root.format(22);
                }
            }

            MenuItem {
                title: root.heading-names[3];
                checked: root.formatting && root.mark-heading == 3;
                shortcut: @keys(Control + "3");
                enabled: root.formatting;
                activated => {
                    root.format(23);
                }
            }

            MenuItem {
                title: root.heading-names[4];
                checked: root.formatting && root.mark-heading == 4;
                shortcut: @keys(Control + "4");
                enabled: root.formatting;
                activated => {
                    root.format(24);
                }
            }

            MenuItem {
                title: root.heading-names[5];
                checked: root.formatting && root.mark-heading == 5;
                shortcut: @keys(Control + "5");
                enabled: root.formatting;
                activated => {
                    root.format(25);
                }
            }

            MenuItem {
                title: root.heading-names[6];
                checked: root.formatting && root.mark-heading == 6;
                shortcut: @keys(Control + "6");
                enabled: root.formatting;
                activated => {
                    root.format(26);
                }
            }
        }

        Menu {
            title: Strings.menu-slide;

            MenuItem {
                title: Strings.menu-new-slide;
                shortcut: @keys(Control + Shift + N);
                enabled: root.viewer == 2 && root.can-save;
                activated => {
                    root.slide-command(0);
                }
            }

            MenuItem {
                title: Strings.menu-duplicate-slide;
                enabled: root.viewer == 2 && root.can-save && root.viewer-note == "";
                activated => {
                    root.slide-command(1);
                }
            }

            MenuItem {
                title: Strings.menu-delete-slide;
                enabled: root.viewer == 2 && root.can-save && root.viewer-note == "";
                activated => {
                    root.slide-command(2);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-duplicate-shape;
                shortcut: @keys(Control + D);
                enabled: root.viewer == 2 && root.slide-shape;
                activated => {
                    root.slide-command(3);
                }
            }

            MenuItem {
                title: Strings.menu-delete-shape;
                enabled: root.viewer == 2 && root.slide-shape;
                activated => {
                    root.slide-command(4);
                }
            }

            MenuItem {
                title: Strings.menu-bring-front;
                shortcut: @keys(Control + Shift + "]");
                enabled: root.viewer == 2 && root.slide-shape;
                activated => {
                    root.slide-command(5);
                }
            }

            MenuItem {
                title: Strings.menu-send-back;
                shortcut: @keys(Control + Shift + "[");
                enabled: root.viewer == 2 && root.slide-shape;
                activated => {
                    root.slide-command(6);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-indent-more;
                enabled: root.viewer == 2 && root.slide-text;
                activated => {
                    root.slide-command(7);
                }
            }

            MenuItem {
                title: Strings.menu-indent-less;
                enabled: root.viewer == 2 && root.slide-text;
                activated => {
                    root.slide-command(8);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-present;
                shortcut: @keys(Control + Return);
                enabled: root.viewer == 2 && root.viewer-note == "";
                activated => {
                    root.slide-command(9);
                }
            }
        }
    }

    VerticalLayout {
        TabStrip {
            tabs: root.tabs;
            active-index: root.active-index;
            kinds: root.kinds;
            leading-inset: root.leading-inset;
            sidebar-open: root.sidebar-open;
            assistant-open: root.assistant-open;
            languages: root.languages;
            language-index: root.language-index;
            activate(index) => {
                root.tab-activate(index);
            }
            close(index) => {
                root.tab-close(index);
            }
            new-document(kind) => {
                root.new-document(kind);
            }
            show-start => {
                root.show-start();
            }
            toggle-sidebar => {
                root.sidebar-open = !root.sidebar-open;
            }
            toggle-theme => {
                root.toggle-theme();
            }
            toggle-assistant => {
                root.assistant-open = !root.assistant-open;
            }
            set-language(index) => {
                root.set-language(index);
            }
            drag-window => {
                root.drag-window();
            }
            toggle-maximize => {
                root.toggle-maximize();
            }
        }

        Hairline { }

        HorizontalLayout {
            vertical-stretch: 1;

            Sidebar {
                width: root.sidebar-open ? Tokens.sidebar-width : 0px;
                animate width {
                    duration: 140ms;
                    easing: ease-out;
                }
                recent: root.sidebar-recent;
                tree: root.tree;
                folder-name: root.folder-name;
                filtering: root.sidebar-filtering;
                filter <=> root.sidebar-filter;
                filter-edited(text) => {
                    root.sidebar-filter-edited(text);
                }
                open-recent(index) => {
                    root.recent-action(0, true, index);
                }
                reveal-recent(index) => {
                    root.recent-action(1, true, index);
                }
                remove-recent(index) => {
                    root.recent-action(2, true, index);
                }
                clear-recent => {
                    root.clear-recent();
                }
                tree-clicked(index) => {
                    root.tree-action(0, index);
                }
                reveal-tree(index) => {
                    root.tree-action(1, index);
                }
                tree-act(action, index) => {
                    root.tree-action(action, index);
                }
                open-folder => {
                    root.open-folder();
                }
                refresh => {
                    root.refresh-folder();
                }
                outline: root.outline;
                has-outline: root.has-outline;
                outline-clicked(index) => {
                    root.outline-clicked(index);
                }
                outline-toggled(index) => {
                    root.outline-toggled(index);
                }
                outline-pdf: root.outline-pdf;
                outline-hint: root.outline-hint;
            }

            // The toolbar belongs to the document: it sits over the document
            // area only, so the sidebar does not move when the first
            // document opens.
            VerticalLayout {
                horizontal-stretch: 1;
                if root.active-kind >= 0: Toolbar {
                    items: root.toolbar-items;
                    command(id) => {
                        root.toolbar-command(id);
                    }
                    option(id, index) => {
                        root.toolbar-option(id, index);
                    }
                    // The list then acts on the document, which takes the
                    // keyboard back from the find bar or another field.
                    opening => {
                        scope.focus();
                    }
                }

                content := Rectangle {
                    vertical-stretch: 1;
                    background: Tokens.desk;
                    clip: true;

                    findbar := FindBar {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        // Markdown documents and workbooks.
                        visible: root.find-open && (root.active-kind == 3 || root.viewer == 1 || root.viewer == 3);
                        // A PDF is searched for text only: no replacing, no
                        // whole words or patterns.
                        simple: root.viewer == 3;
                        replace-visible: root.find-replace;
                        query <=> root.find-query;
                        replacement <=> root.find-replacement;
                        position: root.find-position;
                        error: root.find-error;
                        match-case: root.find-case;
                        whole-word: root.find-whole;
                        use-regex: root.find-regex;
                        sheet-mode: root.viewer == 1;
                        whole-cell: root.find-whole-cell;
                        in-workbook: root.find-workbook;
                        busy: root.find-busy;
                        query-edited(text) => {
                            root.find-query-edited(text);
                        }
                        replacement-edited(text) => {
                            root.find-replacement-edited(text);
                        }
                        next => {
                            root.find-next();
                        }
                        previous => {
                            root.find-previous();
                        }
                        close => {
                            root.find-close();
                        }
                        toggle(option) => {
                            root.find-toggle(option);
                        }
                        replace-one => {
                            root.replace-one();
                        }
                        replace-all => {
                            root.replace-all();
                        }
                    }

                    // Always present so its size is known before the first Writer
                    // tab opens; other views are stacked on top of it.
                    formula-bar := FormulaBar {
                        x: 0;
                        y: findbar.visible ? findbar.height : 0px;
                        width: parent.width;
                        visible: root.viewer == 1;
                        address: root.cell-address;
                        content: root.cell-content;
                        clicked => {
                            root.formula-bar-clicked();
                            scope.focus();
                        }
                    }

                    sheet-bar := SheetBar {
                        x: 0;
                        y: parent.height - self.height;
                        width: parent.width;
                        visible: root.viewer == 1;
                        names: root.sheet-names;
                        current: root.sheet-index;
                        editable: root.can-save;
                        selected(index) => {
                            root.sheet-selected(index);
                            scope.focus();
                        }
                        add => {
                            root.sheet-add();
                            scope.focus();
                        }
                        rename(index) => {
                            root.sheet-rename(index);
                        }
                        delete(index) => {
                            root.sheet-delete(index);
                            scope.focus();
                        }
                        move-copy(index) => {
                            root.sheet-move-copy(index);
                        }
                        moved(from, to) => {
                            root.sheet-move(from, to);
                            scope.focus();
                        }
                    }

                    notes-panel := NotesPanel {
                        x: 0;
                        y: parent.height - self.height;
                        width: parent.width;
                        visible: root.viewer == 2 && root.viewer-note == "";
                        text <=> root.slide-notes;
                        editable: root.can-save;
                        expanded: root.notes-expanded;
                        toggled => {
                            root.notes-expanded = !root.notes-expanded;
                        }
                        edited(text) => {
                            root.notes-edited(text);
                        }
                    }

                    surface := Rectangle {
                        y: (findbar.visible ? findbar.height : 0px) + (formula-bar.visible ? formula-bar.height : 0px);
                        height: parent.height - self.y - (sheet-bar.visible ? sheet-bar.height : notes-panel.visible ? notes-panel.height : 0px);
                        visible: root.surface-active;
                        // The source takes the whole width, the left half, or
                        // nothing; the preview the rest, after a hairline.
                        property <length> editor-width: root.view-mode == 0 ? self.width : root.view-mode == 1 ? round((self.width - 1px) / 2 / 1px) * 1px : 0px;

                        editor-pane := Rectangle {
                            x: 0;
                            width: parent.editor-width;
                            height: parent.height;
                            clip: true;

                            // The frames are drawn at the pane's size; their pixel
                            // size must not feed back into the window's layout.
                            Image {
                                source: root.frame;
                                width: 100%;
                                height: 100%;
                                preferred-width: 0px;
                                preferred-height: 0px;
                                image-fit: fill;
                                visible: root.view-mode != 2;
                            }

                            scope := FocusScope {
                                enabled: root.surface-active;
                                key-pressed(event) => {
                                    return root.key-pressed(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt) ? accept : reject;
                                }

                                TouchArea {
                                    enabled: root.surface-active && root.view-mode != 2;
                                    mouse-cursor: root.viewer == 2 ? (root.slide-cursor == 1 ? MouseCursor.text : root.slide-cursor == 2 ? MouseCursor.move : root.slide-cursor == 3 ? MouseCursor.ew-resize : root.slide-cursor == 4 ? MouseCursor.ns-resize : root.slide-cursor == 5 ? MouseCursor.nwse-resize : root.slide-cursor == 6 ? MouseCursor.nesw-resize : MouseCursor.default) : root.resize-cursor == 1 ? MouseCursor.col-resize : root.resize-cursor == 2 ? MouseCursor.row-resize : root.resize-cursor == 3 ? MouseCursor.crosshair : root.resize-cursor == 4 ? MouseCursor.text : root.viewer > 0 ? MouseCursor.default : MouseCursor.text;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            scope.focus();
                                            root.pointer-down(self.mouse-x, self.mouse-y, event.modifiers.shift);
                                        }
                                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                            root.pointer-up();
                                        }
                                        if (event.kind == PointerEventKind.move) {
                                            root.drag-shift = event.modifiers.shift;
                                        }
                                    }
                                    changed mouse-x => {
                                        if (!self.pressed && root.viewer > 0) {
                                            root.pointer-hover(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    changed mouse-y => {
                                        if (!self.pressed && root.viewer > 0) {
                                            root.pointer-hover(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.pointer-drag(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    double-clicked => {
                                        root.pointer-double(self.mouse-x, self.mouse-y);
                                    }
                                    scroll-event(event) => {
                                        root.scrolled(event.delta-x, event.delta-y, self.mouse-x);
                                        return accept;
                                    }
                                }
                            }

                            dropdown-popup := PopupWindow {
                                x: max(0px, min(root.dropdown-x, parent.width - self.width));
                                y: root.dropdown-y;
                                width: max(root.dropdown-width, 160px);
                                close-policy: PopupClosePolicy.close-on-click-outside;
                                MenuFrame { }

                                ChoiceList {
                                    items: root.dropdown-items;
                                    chosen(index) => {
                                        dropdown-popup.close();
                                        root.dropdown-choose(index);
                                        scope.focus();
                                    }
                                }
                            }

                            filter-popup := PopupWindow {
                                x: max(0px, min(root.filter-x, parent.width - self.width));
                                y: root.filter-y;
                                width: 240px;
                                close-policy: PopupClosePolicy.close-on-click-outside;
                                MenuFrame { }

                                FilterList {
                                    choices: root.filter-choices;
                                    all-on: root.filter-all-on;
                                    some-on: root.filter-some-on;
                                    sort(descending) => {
                                        filter-popup.close();
                                        root.filter-sort(descending);
                                        scope.focus();
                                    }
                                    toggle(index) => {
                                        root.filter-toggle(index);
                                    }
                                    apply => {
                                        filter-popup.close();
                                        root.filter-apply();
                                        scope.focus();
                                    }
                                    cancel => {
                                        filter-popup.close();
                                        scope.focus();
                                    }
                                }
                            }

                            if root.comment-text != "" && root.viewer == 1: Rectangle {
                                accessible-role: text;
                                accessible-label: root.comment-text;
                                x: max(0px, min(root.comment-x, parent.width - self.width));
                                y: max(0px, min(root.comment-y, parent.height - self.height));
                                width: 220px;
                                height: comment-body.preferred-height + 2 * Tokens.space-sm;
                                background: Tokens.surface;
                                border-color: Tokens.outline;
                                border-width: 1px;
                                border-radius: Tokens.radius-sm;
                                drop-shadow-blur: 12px;
                                drop-shadow-offset-y: 3px;
                                drop-shadow-color: Tokens.dark ? #00000099 : #00000033;

                                comment-body := Text {
                                    x: Tokens.space-sm;
                                    y: Tokens.space-sm;
                                    width: parent.width - 2 * Tokens.space-sm;
                                    text: root.comment-text;
                                    color: Tokens.text;
                                    font-size: Tokens.font-sm;
                                    wrap: word-wrap;
                                }
                            }

                            // Hints for the formula being typed. Plain rectangles, not a popup
            // window: the keyboard stays with the document, and an input method
            // composing there is never interrupted.
            hint-layer := Rectangle {
                width: parent.width;
                height: parent.height;
                visible: root.viewer == 1 && (root.hint-call-before != "" || root.hint-items.length > 0);
                property <bool> has-call: root.hint-call-before != "";
                property <length> call-height: Tokens.control-height;
                property <length> row-height: Tokens.control-height;
                property <length> list-height: min(root.hint-items.length, 8) * self.row-height + 2 * Tokens.space-xs;
                property <length> stack-height: (self.has-call ? self.call-height + 2px : 0px) + (root.hint-items.length > 0 ? self.list-height : 0px);
                property <length> base-y: root.hint-bottom + 2px + self.stack-height > self.height ? max(0px, root.hint-top - 2px - self.stack-height) : root.hint-bottom + 2px;

                if hint-layer.has-call: Rectangle {
                    accessible-role: text;
                    accessible-label: root.hint-call-before + root.hint-call-current + root.hint-call-after;
                    width: min(call-row.preferred-width + 2 * Tokens.space-sm, hint-layer.width - 2 * Tokens.space-sm);
                    height: hint-layer.call-height;
                    x: max(0px, min(root.hint-x, hint-layer.width - self.width));
                    y: hint-layer.base-y;
                    background: Tokens.surface;
                    border-color: Tokens.outline;
                    border-width: 1px;
                    border-radius: Tokens.radius-sm;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-color: Tokens.dark ? #00000099 : #00000033;
                    clip: true;

                    call-row := HorizontalLayout {
                        padding-left: Tokens.space-sm;
                        padding-right: Tokens.space-sm;
                        Text {
                            text: root.hint-call-before;
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.hint-call-current;
                            color: Tokens.text;
                            font-size: Tokens.font-sm;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.hint-call-after;
                            color: Tokens.text-secondary;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.hint-items.length > 0: Rectangle {
                    accessible-role: list;
                    accessible-label: Strings.formula-hint-list;
                    width: min(380px, hint-layer.width - 2 * Tokens.space-sm);
                    height: hint-layer.list-height;
                    x: max(0px, min(root.hint-x, hint-layer.width - self.width));
                    y: hint-layer.base-y + (hint-layer.has-call ? hint-layer.call-height + 2px : 0px);
                    background: Tokens.surface;
                    border-color: Tokens.outline;
                    border-width: 1px;
                    border-radius: Tokens.radius-sm;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-color: Tokens.dark ? #00000099 : #00000033;
                    clip: true;

                    for item[index] in root.hint-items: Rectangle {
                        x: Tokens.space-xs;
                        y: Tokens.space-xs + index * hint-layer.row-height;
                        width: parent.width - 2 * Tokens.space-xs;
                        height: hint-layer.row-height;
                        border-radius: Tokens.radius-sm;
                        background: index == root.hint-selected ? Tokens.accent-soft : row-touch.has-hover ? Tokens.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: item.name + " " + item.detail;
                        accessible-item-selected: index == root.hint-selected;
                        accessible-action-default => {
                            root.hint-choose(index);
                        }

                        row-touch := TouchArea {
                            clicked => {
                                root.hint-choose(index);
                                scope.focus();
                            }
                        }

                        HorizontalLayout {
                            padding-left: Tokens.space-sm;
                            padding-right: Tokens.space-sm;
                            spacing: Tokens.space-sm;
                            Text {
                                text: item.name;
                                color: Tokens.text;
                                font-size: Tokens.font-sm;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            if item.is-name: Text {
                                text: Strings.formula-hint-name;
                                color: Tokens.accent;
                                font-size: Tokens.font-xs;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.detail;
                                color: Tokens.text-secondary;
                                font-size: Tokens.font-xs;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            if root.viewer-note != "": Text {
                                x: Tokens.space-xl;
                                width: parent.width - 2 * Tokens.space-xl;
                                height: parent.height;
                                text: root.viewer-note;
                                color: Tokens.text-secondary;
                                font-size: Tokens.font-md;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            if root.scroll-max > 0 && root.view-mode != 2: ScrollBar {
                                x: parent.width - self.width;
                                height: parent.height;
                                offset: root.scroll-offset;
                                maximum: root.scroll-max;
                                page: parent.height;
                                scroll-to(offset) => {
                                    root.scroll-to(offset);
                                }
                            }
                        }

                        if root.view-mode == 1: Rectangle {
                            x: parent.editor-width;
                            width: 1px;
                            height: parent.height;
                            background: Tokens.hairline;
                        }

                        preview-pane := Rectangle {
                            x: root.view-mode == 1 ? parent.editor-width + 1px : 0px;
                            width: root.view-mode == 0 ? 0px : parent.width - self.x;
                            height: parent.height;
                            clip: true;
                            visible: root.view-mode != 0;

                            Image {
                                source: root.preview-frame;
                                width: 100%;
                                height: 100%;
                                preferred-width: 0px;
                                preferred-height: 0px;
                                image-fit: fill;
                            }

                            // Keys while the preview was clicked last, or is on
                            // screen alone: scrolling, select all, copy.
                            preview-scope := FocusScope {
                                enabled: root.surface-active && root.view-mode != 0;
                                key-pressed(event) => {
                                    return root.key-pressed(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt) ? accept : reject;
                                }
                            }

                            TouchArea {
                                enabled: root.surface-active && root.view-mode != 0;
                                mouse-cursor: root.preview-link-hover ? pointer : text;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        preview-scope.focus();
                                        root.preview-pressed(self.mouse-x, self.mouse-y, event.modifiers.shift);
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        root.preview-released();
                                    }
                                }
                                clicked => {
                                    root.preview-clicked(self.mouse-x, self.mouse-y);
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.preview-dragged(self.mouse-x, self.mouse-y);
                                    } else {
                                        root.preview-moved(self.mouse-x, self.mouse-y);
                                    }
                                }
                                scroll-event(event) => {
                                    root.preview-scrolled(event.delta-y);
                                    return accept;
                                }
                            }

                            if root.preview-note != "": Text {
                                x: Tokens.space-xl;
                                width: parent.width - 2 * Tokens.space-xl;
                                height: parent.height;
                                text: root.preview-note;
                                color: Tokens.text-secondary;
                                font-size: Tokens.font-md;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            if root.preview-scroll-max > 0: ScrollBar {
                                x: parent.width - self.width;
                                height: parent.height;
                                offset: root.preview-scroll-offset;
                                maximum: root.preview-scroll-max;
                                page: parent.height;
                                scroll-to(offset) => {
                                    root.preview-scroll-to(offset);
                                }
                            }
                        }
                    }

                    if root.active-kind > 0 && root.active-kind != 3 && root.viewer == 0: Placeholder {
                        kind: root.active-kind;
                        title: root.placeholder-title;
                        plan: root.placeholder-plan;
                    }

                    if root.active-kind < 0: StartPage {
                        kinds: root.kinds;
                        recent: root.recent;
                        new-document(kind) => {
                            root.new-document(kind);
                        }
                        open-recent(index) => {
                            root.recent-action(0, false, index);
                        }
                        reveal-recent(index) => {
                            root.recent-action(1, false, index);
                        }
                        remove-recent(index) => {
                            root.recent-action(2, false, index);
                        }
                        clear-recent => {
                            root.clear-recent();
                        }
                        open-file => {
                            root.file-open();
                        }
                        open-folder => {
                            root.open-folder();
                        }
                    }
                }
            }

            AssistantPanel {
                width: root.assistant-open ? self.panel-width : 0px;
                items: root.ai-items;
                approvals: root.ai-approvals;
                running: root.ai-running;
                configured: root.ai-configured;
                access-level: root.ai-access-level;
                access-label: root.ai-access-label;
                provider: root.ai-provider;
                base-url <=> root.ai-base-url;
                model <=> root.ai-model;
                key-state: root.ai-key-state;
                redact: root.ai-redact;
                untitled-level: root.ai-untitled-level;
                folder-label: root.ai-folder-label;
                folder-level: root.ai-folder-level;
                mcp-enabled: root.mcp-enabled;
                mcp-status: root.mcp-status;
                mcp-clients: root.mcp-clients;
                mcp-setup-cli: root.mcp-setup-cli;
                mcp-setup-json: root.mcp-setup-json;
                models: root.ai-models;
                models-state: root.ai-models-state;
                chats: root.ai-chats;
                mcp-client-names: root.mcp-client-names;
                disconnect-client(index) => {
                    root.mcp-disconnect-client(index);
                }
                can-insert: root.ai-can-insert;
                last-reply: root.ai-last-reply;
                switch-chat(index) => {
                    root.ai-switch-chat(index);
                }
                reply-action(row, action) => {
                    root.ai-reply-action(row, action);
                }
                insecure: root.ai-insecure;
                allow-insecure: root.ai-allow-insecure;
                set-allow-insecure(on) => {
                    root.ai-set-allow-insecure(on);
                }
                pick-model(id) => {
                    root.ai-pick-model(id);
                }
                refresh-models => {
                    root.ai-refresh-models();
                }
                settings-opened => {
                    root.ai-refresh-models();
                }
                send(text) => {
                    root.ai-send(text);
                }
                quick(action) => {
                    root.ai-quick(action);
                }
                stop => {
                    root.ai-stop();
                }
                new-chat => {
                    root.ai-new-chat();
                }
                set-access(level) => {
                    root.ai-set-access(level);
                }
                answer(id, choice) => {
                    root.ai-answer(id, choice);
                }
                set-provider(index) => {
                    root.ai-set-provider(index);
                }
                set-base-url(text) => {
                    root.ai-set-base-url(text);
                }
                set-model(text) => {
                    root.ai-set-model(text);
                }
                save-key(text) => {
                    root.ai-save-key(text);
                }
                delete-key => {
                    root.ai-delete-key();
                }
                set-redact(on) => {
                    root.ai-set-redact(on);
                }
                set-untitled-level(level) => {
                    root.ai-set-untitled-level(level);
                }
                set-folder-level(level) => {
                    root.ai-set-folder-level(level);
                }
                set-mcp(on) => {
                    root.mcp-set-enabled(on);
                }
                copy(text) => {
                    root.copy-to-clipboard(text);
                }
                animate width {
                    duration: 140ms;
                    easing: ease-out;
                }
            }
        }

        StatusBar {
            kind-label: root.status-kind;
            note: root.status-note;
            words: root.status-words;
            chars: root.status-chars;
            file-format: root.status-format;
            notice: root.status-notice;
            ime-label: root.status-ime;
            ime-composing: root.status-composing;
            zoom-label: root.status-zoom;
            zoom-enabled: root.zoom-enabled;
            zoom-out => {
                root.zoom-out();
            }
            zoom-reset => {
                root.zoom-reset();
            }
            zoom-in => {
                root.zoom-in();
            }
        }
    }

    if root.recovery-items.length > 0: RecoveryDialog {
        items: root.recovery-items;
        restore(index) => {
            root.recovery-restore(index);
        }
        discard(index) => {
            root.recovery-discard(index);
        }
        restore-all => {
            root.recovery-restore-all();
        }
        later => {
            root.recovery-later();
        }
    }

    if root.encoding-open: EncodingDialog {
        title: root.encoding-title;
        body: root.encoding-body;
        choices: root.encoding-choices;
        selected <=> root.encoding-selected;
        confirmed => {
            root.encoding-accept();
        }
        dismissed => {
            root.encoding-cancel();
        }
    }

    if root.copy-open: CopyDialog {
        title: root.copy-title;
        label: root.copy-label;
        places: root.copy-places;
        selected <=> root.copy-selected;
        copy <=> root.copy-make-copy;
        confirmed => {
            root.copy-accept();
        }
        dismissed => {
            root.copy-cancel();
        }
    }

    if root.prompt-open: PromptDialog {
        title: root.prompt-title;
        label: root.prompt-label;
        problem: root.prompt-problem;
        multiline: root.prompt-multiline;
        text <=> root.prompt-text;
        secret: root.prompt-secret;
        confirmed => {
            root.prompt-accept();
        }
        dismissed => {
            root.prompt-cancel();
        }
    }

    if root.link-open: LinkDialog {
        image: root.link-image;
        label <=> root.link-label;
        address <=> root.link-address;
        confirmed => {
            root.link-accept();
        }
        dismissed => {
            root.link-cancel();
        }
    }

    // After the recovery question, so a message raised while it is open
    // appears on top of it.
    if root.dialog-kind != 0: Dialog {
        kind: root.dialog-kind;
        title: root.dialog-title;
        body: root.dialog-body;
        save => {
            root.dialog-save();
        }
        discard => {
            root.dialog-discard();
        }
        cancel => {
            root.dialog-cancel();
        }
    }

    // The slide show: the slide on black over the whole window. Keys and
    // clicks move through it; Esc leaves.
    if root.presenting: Rectangle {
        background: black;
        show-scope := FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                root.show-key(event.text, event.modifiers.shift);
                return accept;
            }
            Image {
                source: root.show-frame;
                width: 100%;
                height: 100%;
                preferred-width: 0px;
                preferred-height: 0px;
                image-fit: fill;
            }
            TouchArea {
                mouse-cursor: MouseCursor.none;
                clicked => {
                    show-scope.focus();
                    root.show-click();
                }
            }
        }
    }

    // Over everything while files are dragged onto the window. Draws only;
    // the drop itself arrives from the window system.
    if root.drop-hover: Rectangle {
        background: Tokens.accent-soft;
        opacity: 0.92;
        border-width: 2px;
        border-color: Tokens.accent;
        border-radius: Tokens.radius-lg;
        Rectangle {
            width: drop-label.preferred-width + 2 * Tokens.space-lg;
            height: 40px;
            border-radius: self.height / 2;
            background: Tokens.surface;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000026;
            drop-label := Text {
                text: Strings.drop-to-open;
                font-size: Tokens.font-lg;
                font-weight: 600;
                color: Tokens.accent;
            }
        }
    }
}
