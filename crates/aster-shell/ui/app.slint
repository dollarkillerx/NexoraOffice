// The Aster Office main window: tab strip, toolbar, sidebar, document area and
// status bar. Everything here is chrome; the document area of a Writer tab is
// one image that the Rust side draws itself, and Slint only forwards input to it.
// A Markdown tab has up to two: the source and the preview.

import { Tokens, Icons, Strings, TabItem, ToolItem, KindItem, RecentItem, TreeItem, RecoveryItem, ChatItem, ApprovalItem, OutlineItem, EncodingChoice, FilterChoice, HintItem } from "tokens.slint";
import { FilterList } from "filter_list.slint";
import { ChoiceList } from "choice_list.slint";
import { TabStrip } from "tabstrip.slint";
import { Toolbar } from "toolbar.slint";
import { Sidebar } from "sidebar.slint";
import { StartPage } from "start.slint";
import { Placeholder } from "placeholder.slint";
import { StatusBar } from "statusbar.slint";
import { AssistantPanel } from "assistant.slint";
import { Dialog } from "dialog.slint";
import { LinkDialog } from "link_dialog.slint";
import { PromptDialog } from "prompt_dialog.slint";
import { CopyDialog } from "copy_dialog.slint";
import { EncodingDialog } from "encoding_dialog.slint";
import { RecoveryDialog } from "recovery.slint";
import { Hairline, ScrollBar, MenuFrame } from "widgets.slint";
import { FindBar } from "findbar.slint";
import { FormulaBar, SheetBar } from "sheetbar.slint";
import { NotesPanel } from "notes.slint";

export { Tokens, Icons, Strings, ChatItem, ApprovalItem }

export component AppWindow inherits Window {
    title: root.active-title == "" ? "Aster Office" : root.active-title + " — Aster Office";
    // Window and taskbar icon on Windows and X11. macOS takes the Dock icon from
    // the bundle and Wayland from the desktop entry, so this does nothing there.
    icon: @image-url("../../../assets/brand/logo/png/aster-icon-256.png");
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 420px;
    background: Tokens.surface;
    default-font-size: Tokens.font-md;

    in property <[TabItem]> tabs;
    // -1 while the start page is showing.
    in property <int> active-index: -1;
    // Kind of the document in front, -1 on the start page.
    in property <int> active-kind: -1;
    in property <string> active-title;
    in property <string> placeholder-title;
    in property <string> placeholder-plan;
    in property <[ToolItem]> toolbar-items;
    in property <[KindItem]> kinds;
    // Every recent file, for the start page.
    in property <[RecentItem]> recent;
    // The few the sidebar lists, or every match while it filters.
    in property <[RecentItem]> sidebar-recent;
    in property <[TreeItem]> tree;
    // The folder shown in the sidebar; empty while none is open.
    in property <string> folder-name;
    in-out property <string> sidebar-filter;
    in property <bool> sidebar-filtering;
    // The document in front has a file on disk.
    in property <bool> current-has-file;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> assistant-open;
    // The assistant panel and MCP; see assistant.slint.
    in property <[ChatItem]> ai-items;
    in property <[ApprovalItem]> ai-approvals;
    in property <bool> ai-running;
    in property <bool> ai-configured;
    in property <int> ai-access-level: -1;
    in property <string> ai-access-label;
    in property <int> ai-provider;
    in-out property <string> ai-base-url;
    in-out property <string> ai-model;
    in property <string> ai-key-state;
    in property <bool> ai-redact: true;
    in property <int> ai-untitled-level;
    in property <string> ai-folder-label;
    in property <int> ai-folder-level;
    in property <bool> mcp-enabled;
    in property <string> mcp-status;
    in property <string> mcp-clients;
    in property <string> mcp-setup-cli;
    in property <string> mcp-setup-json;
    in property <[string]> ai-models;
    in property <[string]> ai-chats;
    in property <[string]> mcp-client-names;
    in property <bool> ai-can-insert;
    in property <int> ai-last-reply: -1;
    in property <string> ai-models-state;
    in property <bool> ai-insecure;
    in property <bool> ai-allow-insecure;
    // The link dialog: open, for an image, and what its fields hold.
    in property <bool> link-open;
    in property <bool> link-image;
    in-out property <string> link-label;
    in-out property <string> link-address;
    callback link-accept();
    callback link-cancel();
    // A question asking for one line of text: go to line, rename.
    in property <bool> prompt-open;
    in property <string> prompt-title;
    in property <string> prompt-label;
    in property <string> prompt-problem;
    in property <bool> prompt-multiline;
    in-out property <string> prompt-text;
    in property <bool> prompt-secret;
    callback prompt-accept();
    callback prompt-cancel();
    callback menu-go-to-line();
    // Choosing the encoding a file is read in.
    in property <bool> encoding-open;
    in property <string> encoding-title;
    in property <string> encoding-body;
    in property <[EncodingChoice]> encoding-choices;
    in-out property <int> encoding-selected;
    callback encoding-accept();
    callback encoding-cancel();
    // What the document in front is written as: its encoding is UTF-8, its
    // lines end in CRLF.
    in property <bool> format-utf8: true;
    in property <bool> format-crlf;
    callback menu-reopen-encoding();
    callback menu-convert-utf8();
    callback menu-line-endings(bool);
    // The sidebar's outline of the Markdown document in front.
    in property <[OutlineItem]> outline;
    in property <bool> has-outline;
    callback outline-clicked(int);
    callback outline-toggled(int);
    // The outline shown is a PDF's, and what to say when it is empty.
    in property <bool> outline-pdf;
    in property <string> outline-hint;
    callback ai-send(string);
    callback ai-quick(int);
    callback ai-switch-chat(int);
    callback mcp-disconnect-client(int);
    callback ai-reply-action(int, int);
    callback ai-stop();
    callback ai-new-chat();
    callback ai-set-access(int);
    callback ai-answer(int, int);
    callback ai-set-provider(int);
    callback ai-set-base-url(string);
    callback ai-set-model(string);
    callback ai-save-key(string);
    callback ai-delete-key();
    callback ai-set-redact(bool);
    callback ai-set-untitled-level(int);
    callback ai-set-folder-level(int);
    callback mcp-set-enabled(bool);
    callback ai-pick-model(string);
    callback ai-refresh-models();
    callback ai-set-allow-insecure(bool);
    in property <[string]> languages;
    in property <int> language-index;
    // Room for the window buttons where the tab strip doubles as the title bar.
    in property <length> leading-inset;

    // The tab in front is a document that can be edited, saved and undone.
    in property <bool> editing;
    // The active tab is a document that can be saved and undone: a
    // Markdown document or a workbook.
    in property <bool> can-save;
    // A dialog with a text field is open. The Edit menu's text commands
    // step aside, so their shortcuts (Cmd+A, Cmd+C ...) reach the field
    // rather than the document behind it.
    property <bool> dialog-text: root.prompt-open || root.link-open;
    // Its source is on screen, so the Format menu can write into it.
    property <bool> formatting: root.editing && root.view-mode != 2;
    // The caret is in a table: the table's row and column commands apply.
    in property <bool> in-table;
    // The styles at the caret, for check marks in the Format menu: block 0
    // none, 1 bullets, 2 numbers, 3 tasks, 4 quote; heading 0 body text.
    in property <bool> mark-bold;
    // The active cell of a workbook, for the Format menu's checks.
    in property <bool> cell-bold;
    in property <bool> cell-italic;
    in property <bool> cell-underline;
    in property <bool> cell-strike;
    // The Format menu's character formats act on a workbook's cells.
    // Workbooks, and text on a slide: the Format menu's bold, italic,
    // underline and strikethrough act on them through `sheet-format`.
    property <bool> sheet-formatting: (root.viewer == 1 || (root.viewer == 2 && root.slide-text)) && root.can-save;
    in property <bool> mark-italic;
    in property <bool> mark-strike;
    in property <bool> mark-code;
    in property <int> mark-block;
    in property <int> mark-heading;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // 0 while no question is open; see dialog.slint for the kinds.
    in property <int> dialog-kind;
    // Files are being dragged over the window.
    in property <bool> drop-hover;
    in property <string> dialog-title;
    in property <string> dialog-body;
    // Documents a crash left unsaved; the question is shown while any remain.
    in property <[RecoveryItem]> recovery-items;

    in property <string> status-kind;
    in property <string> status-note;
    in property <string> status-words;
    in property <string> status-chars;
    in property <string> status-format;
    in property <string> status-notice;
    in property <string> status-ime;
    in property <bool> status-composing;
    in property <string> status-zoom;
    in property <bool> zoom-enabled;

    // The frame the Rust side rendered for the document surface.
    in property <image> frame;
    // Scroll position of the surface, for the scroll indicator.
    in property <length> scroll-offset;
    in property <length> scroll-max;

    // How a Markdown tab shows its document: 0 the source, 1 source and
    // preview side by side, 2 the preview. Always 0 for other tabs.
    in property <int> view-mode;
    in property <image> preview-frame;
    in property <length> preview-scroll-offset;
    in property <length> preview-scroll-max;
    // The pointer is over a link in the preview.
    in property <bool> preview-link-hover;
    // Shown in the preview pane instead of a preview, such as for a document
    // too large to preview.
    in property <string> preview-note;

    // The find bar of the Markdown tab in front.
    in property <bool> find-open;
    in property <bool> find-replace;
    in-out property <string> find-query;
    in-out property <string> find-replacement;
    in property <string> find-position;
    in property <bool> find-error;
    in property <bool> find-case;
    in property <bool> find-whole;
    in property <bool> find-regex;
    in property <bool> find-whole-cell;
    in property <bool> find-workbook;
    in property <bool> find-busy;

    // Geometry the Rust side needs to size its buffer and place the candidate window.
    out property <length> surface-width: editor-pane.width;
    out property <length> surface-height: editor-pane.height;
    out property <length> surface-x: editor-pane.absolute-position.x;
    out property <length> surface-y: editor-pane.absolute-position.y;
    out property <bool> surface-focused: scope.has-focus;
    out property <length> preview-width: preview-pane.width;
    out property <length> preview-height: preview-pane.height;
    // Read-only views of files: 0 none, 1 a workbook, 2 a presentation.
    in property <int> viewer;
    // The selected cell of a workbook, and the sheets one can switch to.
    in property <string> cell-address;
    in property <string> cell-content;
    in property <[string]> sheet-names;
    in property <int> sheet-index: -1;
    // Shown over a viewer's surface: a chart sheet, a presentation without
    // slides.
    in property <string> viewer-note;
    // The current slide's speaker notes, and whether their panel is open.
    in-out property <string> slide-notes;
    // Slides tabs: there is text to format; a shape is selected; the
    // pointer's look over the slide (0 default, 1 text, 2 move, 3 to 6
    // resizing across, down, and the two diagonals).
    in property <bool> slide-text;
    in property <bool> slide-shape;
    in property <int> slide-cursor;
    // Shift is held while the pointer moves with the button down.
    out property <bool> drag-shift;
    // The Slide menu: 0 new slide, 1 duplicate slide, 2 delete slide,
    // 3 duplicate shape, 4 delete shape, 5 bring to front, 6 send to back,
    // 7 and 8 list level up and down, 9 start the slide show.
    callback slide-command(int);
    // The notes of the current slide were typed into.
    callback notes-edited(string);
    // The slide show: its picture, its size, and a key or click in it.
    in property <bool> presenting;
    in property <image> show-frame;
    out property <length> show-width: root.width;
    out property <length> show-height: root.height;
    callback show-key(string, bool);
    callback show-click();
    in-out property <bool> notes-expanded: true;

    // Writer and Markdown tabs and the viewers show the custom-drawn surface.
    property <bool> surface-active: root.active-kind == 0 || root.active-kind == 3 || root.viewer > 0;

    callback tab-activate(int);
    callback tab-close(int);
    callback new-document(int);
    callback show-start();
    // 0 open, 1 show in the file manager, 2 take off the list; from the
    // sidebar's short list or the start page's full one.
    callback recent-action(int, bool, int);
    callback clear-recent();
    // 0 open or expand, 1 show in the file manager.
    callback tree-action(int, int);
    callback open-folder();
    callback refresh-folder();
    callback reveal-current();
    callback sidebar-filter-edited(string);
    callback toggle-theme();
    callback set-language(int);
    callback toolbar-command(int);
    // An entry of a toolbar field's list: the field's command, the index.
    callback toolbar-option(int, int);
    // The Format menu. 0 bold, 1 italic, 2 strikethrough, 3 inline code,
    // 4 bulleted list, 5 numbered list, 6 task list, 7 quote, 8 link,
    // 9 image, 10 table, 20 body text, 21 to 26 heading levels.
    callback format(int);
    // Bold, italic, underline, strikethrough (0–3) of a workbook's cells.
    callback sheet-format(int);
    // Body text and heading levels 1 to 6, for the Format menu.
    in property <[string]> heading-names: ["", "", "", "", "", "", ""];
    callback file-new();
    callback file-open();
    callback file-save();
    callback file-save-as();
    callback file-export-html();
    callback file-export-pdf();
    callback file-close();
    callback quit-requested();
    callback edit-undo();
    callback edit-redo();
    callback edit-cut();
    callback edit-copy();
    callback edit-paste();
    callback edit-select-all();
    // Insert (or delete) the columns (or rows) the selection spans.
    callback sheet-lines(/* columns */ bool, /* insert */ bool);
    // Sort the selection's rows (or the data around the active cell) by
    // the active cell's column.
    callback sheet-sort(/* descending */ bool);
    // Freeze panes: 0 the top row, 1 the first column, 2 at the active
    // cell, 3 none.
    callback sheet-freeze(int);
    // The autofilter: put on or taken off; a column's list sorted by it,
    // a value toggled (-1: all), the choice applied.
    callback sheet-filter();
    // Set the print area from the selection (`true`) or clear it.
    callback sheet-print-area(bool);
    callback filter-sort(/* descending */ bool);
    callback filter-toggle(int);
    callback filter-apply();
    // The list of the active cell's drop-down arrow: opened by the arrow,
    // a value chosen.
    callback dropdown-choose(int);
    in property <[string]> dropdown-items;
    in property <length> dropdown-x;
    in property <length> dropdown-y;
    in property <length> dropdown-width;
    // Where the open filter list goes, logical pixels in the document
    // pane, and what it offers.
    in property <length> filter-x;
    in property <length> filter-y;
    in property <[FilterChoice]> filter-choices;
    in property <bool> filter-all-on;
    in property <bool> filter-some-on;
    in property <bool> sheet-filtered;
    in property <bool> sheet-has-print-area;
    // Hide (or show) the columns (or rows) the selection spans.
    callback sheet-hide(/* columns */ bool, /* hide */ bool);
    // The active cell's note: write or change it, take it away.
    callback sheet-comment();
    callback sheet-comment-delete();
    in property <bool> cell-has-comment;
    // The note shown beside a cell (selected or under the pointer), at a
    // place in the document pane, logical pixels; empty text hides it.
    in property <string> comment-text;
    // The hints under the cell being typed into: the signature of the
    // function the caret is in (the argument it is on in bold) and the list
    // of functions and names that complete the word before the caret.
    in property <[HintItem]> hint-items;
    in property <int> hint-selected;
    in property <string> hint-call-before;
    in property <string> hint-call-current;
    in property <string> hint-call-after;
    // The cell's box in the document pane.
    in property <length> hint-x;
    in property <length> hint-top;
    in property <length> hint-bottom;
    callback hint-choose(int);
    in property <length> comment-x;
    in property <length> comment-y;
    callback dialog-save();
    callback dialog-discard();
    callback dialog-cancel();
    callback recovery-restore(int);
    callback recovery-discard(int);
    callback recovery-restore-all();
    callback recovery-later();
    callback zoom-out();
    callback zoom-reset();
    callback zoom-in();
    callback drag-window();
    callback toggle-maximize();
    // text, shift, primary (Cmd on macOS, Ctrl elsewhere), alt. Returns true when handled.
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback pointer-down(length, length, bool);
    callback pointer-drag(length, length);
    // A double click on the surface; a click in the formula bar.
    callback pointer-double(length, length);
    // The button went up; the pointer moved over the surface.
    callback pointer-up();
    callback pointer-hover(length, length);
    // Over an edge that resizes: 1 a column, 2 a row.
    in property <int> resize-cursor;
    callback formula-bar-clicked();
    // Wheel movement across and down, and where the pointer is across.
    callback scrolled(length, length, length);
    callback sheet-selected(int);
    // Of the sheet tabs, counted as shown.
    callback sheet-add();
    callback sheet-rename(int);
    callback sheet-delete(int);
    callback sheet-move(int, int);
    // "Move or Copy" for a sheet tab, and its dialog.
    callback sheet-move-copy(int);
    in property <bool> copy-open;
    in property <string> copy-title;
    in property <string> copy-label;
    in property <[string]> copy-places;
    in-out property <int> copy-selected;
    in-out property <bool> copy-make-copy;
    callback copy-accept();
    callback copy-cancel();
    callback preview-scrolled(length);
    // The scroll bars: scroll the source or the preview to an offset.
    callback scroll-to(length);
    callback preview-scroll-to(length);
    callback find-query-edited(string);
    callback find-replacement-edited(string);
    callback find-next();
    callback find-previous();
    callback find-close();
    // 0 case, 1 whole word, 2 regular expression.
    callback find-toggle(int);
    callback replace-one();
    callback replace-all();
    callback menu-find();
    callback menu-replace();
    callback menu-find-selection();
    callback preview-clicked(length, length);
    callback preview-moved(length, length);
    // A press in the preview starts a selection (with Shift, extends it);
    // moving with the button down drags it.
    callback preview-pressed(length, length, bool);
    callback preview-dragged(length, length);
    callback preview-released();

    // Give the keyboard to the document surface.
    public function show-dropdown-list() {
        dropdown-popup.show();
    }

    public function show-filter-list() {
        filter-popup.show();
    }

    public function focus-document() {
        // With the preview alone on screen, the keyboard scrolls it.
        if (root.view-mode == 2) {
            preview-scope.focus();
        } else {
            scope.focus();
        }
    }

    public function focus-find-query() {
        findbar.focus-query();
    }

    // Slint has no clipboard API for application code, but its text input can
    // copy and paste. This one is never shown; it only carries text to and from
    // the system clipboard. It belongs in aster-platform once that has a
    // clipboard of its own.
    public function copy-to-clipboard(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }

    public function clipboard-text() -> string {
        clipboard.text = "";
        clipboard.paste();
        return clipboard.text;
    }

    clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        single-line: false;
    }

    MenuBar {
        Menu {
            title: Strings.menu-file;
            MenuItem {
                title: Strings.menu-new-markdown;
                shortcut: @keys(Control + N);
                activated => {
                    root.file-new();
                }
            }

            MenuItem {
                title: Strings.menu-open;
                shortcut: @keys(Control + O);
                activated => {
                    root.file-open();
                }
            }

            MenuItem {
                title: Strings.menu-open-folder;
                shortcut: @keys(Control + Shift + O);
                activated => {
                    root.open-folder();
                }
            }

            MenuItem {
                title: Strings.menu-clear-recent;
                activated => {
                    root.clear-recent();
                }
            }

            MenuItem {
                title: Strings.reveal;
                enabled: root.current-has-file;
                activated => {
                    root.reveal-current();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-save;
                shortcut: @keys(Control + S);
                enabled: root.can-save;
                activated => {
                    root.file-save();
                }
            }

            MenuItem {
                title: Strings.menu-save-as;
                shortcut: @keys(Control + Shift + S);
                enabled: root.can-save;
                activated => {
                    root.file-save-as();
                }
            }

            MenuItem {
                title: Strings.menu-reopen-encoding;
                enabled: root.editing;
                activated => {
                    root.menu-reopen-encoding();
                }
            }

            MenuItem {
                title: Strings.menu-convert-utf8;
                enabled: root.editing && !root.format-utf8;
                activated => {
                    root.menu-convert-utf8();
                }
            }

            MenuItem {
                title: Strings.menu-line-endings-lf;
                checked: root.editing && !root.format-crlf;
                enabled: root.editing;
                activated => {
                    root.menu-line-endings(false);
                }
            }

            MenuItem {
                title: Strings.menu-line-endings-crlf;
                checked: root.editing && root.format-crlf;
                enabled: root.editing;
                activated => {
                    root.menu-line-endings(true);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-export-html;
                enabled: root.editing;
                activated => {
                    root.file-export-html();
                }
            }

            MenuItem {
                title: Strings.menu-export-pdf;
                enabled: root.editing;
                activated => {
                    root.file-export-pdf();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-close-tab;
                shortcut: @keys(Control + W);
                enabled: root.active-index >= 0;
                activated => {
                    root.file-close();
                }
            }

            MenuItem {
                title: Strings.menu-quit;
                role: quit;
                activated => {
                    root.quit-requested();
                }
            }
        }

        Menu {
            title: Strings.menu-edit;
            MenuItem {
                title: Strings.menu-undo;
                shortcut: @keys(Control + Z);
                enabled: !root.dialog-text && (findbar.editing-text || (root.can-save && root.can-undo));
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(4);
                    } else {
                        root.edit-undo();
                    }
                }
            }

            MenuItem {
                title: Strings.menu-redo;
                shortcut: @keys(Control + Shift + Z);
                enabled: !root.dialog-text && (findbar.editing-text || (root.can-save && root.can-redo));
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(5);
                    } else {
                        root.edit-redo();
                    }
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-cut;
                shortcut: @keys(Control + X);
                enabled: !root.dialog-text && root.can-save;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(1);
                    } else {
                        root.edit-cut();
                    }
                }
            }

            MenuItem {
                title: Strings.menu-copy;
                shortcut: @keys(Control + C);
                enabled: !root.dialog-text && (root.can-save || root.viewer == 3);
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(2);
                    } else {
                        root.edit-copy();
                    }
                }
            }

            MenuItem {
                title: Strings.menu-paste;
                shortcut: @keys(Control + V);
                enabled: !root.dialog-text && root.can-save;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(3);
                    } else {
                        root.edit-paste();
                    }
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-select-all;
                shortcut: @keys(Control + A);
                enabled: !root.dialog-text && root.surface-active;
                activated => {
                    if (findbar.editing-text) {
                        findbar.edit(0);
                    } else {
                        root.edit-select-all();
                    }
                }
            }

            MenuSeparator { }

            // Rows and columns of a workbook: those the selection spans.
            MenuItem {
                title: Strings.menu-insert-rows;
                enabled: root.viewer == 1 && root.can-save;
                activated => {
                    root.sheet-lines(false, true);
                }
            }

            MenuItem {
                title: Strings.menu-insert-columns;
                enabled: root.viewer == 1 && root.can-save;
                activated => {
                    root.sheet-lines(true, true);
                }
            }

            MenuItem {
                title: Strings.menu-delete-rows;
                enabled: root.viewer == 1 && root.can-save;
                activated => {
                    root.sheet-lines(false, false);
                }
            }

            MenuItem {
                title: Strings.menu-delete-columns;
                enabled: root.viewer == 1 && root.can-save;
                activated => {
                    root.sheet-lines(true, false);
