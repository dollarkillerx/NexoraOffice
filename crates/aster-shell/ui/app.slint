            MenuItem {
                title: Strings.menu-find;
                shortcut: @keys(Control + F);
                enabled: root.editing || root.viewer == 1 || root.viewer == 3;
                activated => {
                    root.menu-find();
                }
            }

            MenuItem {
                title: Strings.menu-find-next;
                shortcut: @keys(Control + G);
                enabled: root.editing || root.viewer == 1 || root.viewer == 3;
                activated => {
                    root.find-next();
