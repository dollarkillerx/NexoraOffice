import { Tokens, Icons, Strings, ChatItem, ApprovalItem } from "tokens.slint";
import { Icon, IconButton, TextButton, VHairline, Hairline, MenuFrame, MenuRow } from "widgets.slint";

// Five access levels in a row: Off, Read, Ask, Trusted, Full.
component LevelPicker inherits HorizontalLayout {
    in property <int> level;
    in property <bool> enabled: true;
    callback picked(int);
    spacing: 2px;
    for name[index] in [Strings.level-off, Strings.level-read-only, Strings.level-ask, Strings.level-trusted, Strings.level-full]: Rectangle {
        height: 24px;
        horizontal-stretch: 1;
        border-radius: Tokens.radius-sm;
        background: root.level == index ? Tokens.accent-soft : touch.has-hover && root.enabled ? Tokens.hover : Tokens.fill;
        accessible-role: button;
        accessible-label: name;
        accessible-checked: root.level == index;
        Text {
            text: name;
            font-size: Tokens.font-sm;
            font-weight: root.level == index ? 600 : 400;
            color: !root.enabled ? Tokens.text-disabled : root.level == index ? Tokens.accent : Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => {
                root.picked(index);
            }
        }
    }
}

// Text that can be selected and copied but not edited.
component ReadText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    font-size: Tokens.font-md;
    color: Tokens.text;
    selection-background-color: Tokens.accent-soft;
    selection-foreground-color: Tokens.text;
}

// A small text button under an answer.
component ReplyLink inherits Text {
    callback clicked;
    font-size: Tokens.font-sm;
    color: link-touch.has-hover ? Tokens.accent : Tokens.text-tertiary;
    accessible-role: button;
    accessible-label: self.text;
    link-touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One entry of the conversation, as tall as what it shows.
component ChatRow inherits VerticalLayout {
    in property <ChatItem> item;
    in property <length> available;
    // The answer can go into the document in front.
    in property <bool> can-insert;
    // This is the last answer, which can be asked again.
    in property <bool> last;
    in property <bool> running;
    // 0 copy, 1 insert at the caret, 2 replace the selection, 3 ask again.
    callback act(int);

    // The user's message: on the right, tinted.
    if root.item.kind == 0: Rectangle {
        height: bubble.height;
        bubble := Rectangle {
            // A little slack: the last glyph must not touch the edge.
            width: min(root.available * 0.85, user-text.preferred-width + 2 * Tokens.space-md + 4px);
            x: root.available - self.width;
            height: user-text.preferred-height + 2 * Tokens.space-sm;
            border-radius: Tokens.radius-lg;
            background: Tokens.accent-soft;
            user-text := ReadText {
                x: Tokens.space-md;
                y: Tokens.space-sm;
                width: parent.width - 2 * Tokens.space-md;
                text: root.item.text;
            }
        }
    }

    // The assistant's answer: plain text across the panel, and what can be
    // done with it.
    if root.item.kind == 1: VerticalLayout {
        spacing: 2px;
        ReadText {
            width: root.available;
            text: root.item.text;
        }

        if root.item.text != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-md;
            ReplyLink {
                text: Strings.ai-reply-copy;
                clicked => {
                    root.act(0);
                }
            }

            if root.can-insert: ReplyLink {
                text: Strings.ai-reply-insert;
                clicked => {
                    root.act(1);
                }
            }

            if root.can-insert: ReplyLink {
                text: Strings.ai-reply-replace;
                clicked => {
                    root.act(2);
                }
            }

            if root.last && !root.running: ReplyLink {
                text: Strings.ai-reply-retry;
                clicked => {
                    root.act(3);
                }
            }
        }
    }

    // A tool call: one quiet line.
    if root.item.kind == 2: HorizontalLayout {
        spacing: Tokens.space-xs;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.item.state == 0 ? Tokens.accent : root.item.state == 1 ? Tokens.text-tertiary : #d1242f;
            }
        }

        Text {
            text: root.item.text + (root.item.detail == "" ? "" : " · " + root.item.detail);
            font-size: Tokens.font-sm;
            font-family: "Menlo";
            color: root.item.state == 2 ? #d1242f : Tokens.text-tertiary;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    if root.item.kind == 3: Text {
        width: root.available;
        text: root.item.text;
        font-size: Tokens.font-md;
        color: #d1242f;
        wrap: word-wrap;
    }

    if root.item.kind == 4: Text {
        width: root.available;
        text: root.item.text;
        font-size: Tokens.font-sm;
        color: Tokens.text-tertiary;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
}

// A labelled block of text on an approval card, with a coloured edge.
component TextBlock inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    in property <brush> tint;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: Tokens.font-xs;
        color: Tokens.text-tertiary;
    }

    Rectangle {
        border-radius: Tokens.radius-sm;
        background: Tokens.fill;
        height: min(block.preferred-height, 120px) + 2 * Tokens.space-sm;
        clip: true;
        Rectangle {
            x: 0;
            width: 3px;
            background: root.tint;
        }

        block := Text {
            x: Tokens.space-sm + 3px;
            y: Tokens.space-sm;
            width: parent.width - 2 * Tokens.space-sm - 3px;
            text: root.text;
            font-size: Tokens.font-sm;
            font-family: "Menlo";
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }
}

component ApprovalCard inherits Rectangle {
    in property <ApprovalItem> item;
    callback answer(int, int);
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.accent;
    background: Tokens.surface;
    height: layout.preferred-height;

    layout := VerticalLayout {
        padding: Tokens.space-md;
        spacing: Tokens.space-sm;
        Text {
            text: root.item.title;
            font-size: Tokens.font-md;
            font-weight: 600;
            color: Tokens.text;
            wrap: word-wrap;
        }

        Text {
            text: root.item.detail;
            font-size: Tokens.font-sm;
            color: Tokens.text-tertiary;
            wrap: word-wrap;
        }

        if root.item.facts != "": Text {
            text: root.item.facts;
            font-size: Tokens.font-sm;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // What goes: the original text, so a deletion is seen for what it is.
        if root.item.removed != "": TextBlock {
            label: Strings.approval-removed-label;
            text: root.item.removed;
            tint: #d1242f;
        }

        if root.item.preview != "": TextBlock {
            label: Strings.approval-inserted-label;
            text: root.item.preview;
            tint: Tokens.accent;
        }

        HorizontalLayout {
            spacing: Tokens.space-sm;
            alignment: end;
            TextButton {
                text: Strings.approve-deny;
                clicked => {
                    root.answer(root.item.id, 0);
                }
            }

            TextButton {
                text: Strings.approve-session;
                clicked => {
                    root.answer(root.item.id, 2);
                }
            }

            TextButton {
                text: Strings.approve-allow;
                primary: true;
                clicked => {
                    root.answer(root.item.id, 1);
                }
            }
        }

        Text {
            text: Strings.approval-timeout;
            font-size: Tokens.font-xs;
            color: Tokens.text-tertiary;
            horizontal-alignment: right;
        }
    }
}

// A labelled one-line text field.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <InputType> input-type: InputType.text;
    callback accepted(string);
    spacing: 4px;
    Text {
        text: root.label;
        font-size: Tokens.font-sm;
        color: Tokens.text-secondary;
    }

    Rectangle {
        height: Tokens.control-height;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: input.has-focus ? Tokens.accent : Tokens.hairline;
        background: Tokens.surface;
        Text {
            x: Tokens.space-sm;
            width: parent.width - 2 * Tokens.space-sm;
            height: parent.height;
            text: root.placeholder;
            visible: input.text == "" && !input.has-focus;
            color: Tokens.text-tertiary;
            font-size: Tokens.font-md;
            vertical-alignment: center;
            overflow: elide;
        }

        input := TextInput {
            x: Tokens.space-sm;
            width: parent.width - 2 * Tokens.space-sm;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            input-type: root.input-type;
            font-size: Tokens.font-md;
            color: Tokens.text;
            text <=> root.text;
            selection-background-color: Tokens.accent-soft;
            selection-foreground-color: Tokens.text;
            accepted => {
                root.accepted(self.text);
            }
        }
    }
}

component Section inherits Text {
    font-size: Tokens.font-md;
    font-weight: 600;
    color: Tokens.text;
}

// A switch with its label.
component Switch inherits HorizontalLayout {
    in property <string> label;
    in property <bool> checked;
    callback toggled(bool);
    spacing: Tokens.space-sm;
    Rectangle {
        width: 30px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Tokens.accent : Tokens.text-disabled;
        accessible-role: switch;
        accessible-checked: root.checked;
        accessible-label: root.label;
        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: white;
            animate x { duration: Tokens.quick; }
        }

        TouchArea {
            clicked => {
                root.toggled(!root.checked);
            }
        }
    }

    Text {
        text: root.label;
        font-size: Tokens.font-md;
        color: Tokens.text;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// A block of text to copy, with its button.
component Snippet inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    callback copy(string);
    spacing: 4px;
    HorizontalLayout {
        Text {
            text: root.label;
            font-size: Tokens.font-sm;
            color: Tokens.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        TextButton {
            text: Strings.mcp-copy;
            clicked => {
                root.copy(root.text);
            }
        }
    }

    Rectangle {
        border-radius: Tokens.radius-sm;
        background: Tokens.fill;
        height: code.preferred-height + 2 * Tokens.space-sm;
        code := ReadText {
            x: Tokens.space-sm;
            y: Tokens.space-sm;
            width: parent.width - 2 * Tokens.space-sm;
            text: root.text;
            font-size: Tokens.font-sm;
            font-family: "Menlo";
            color: Tokens.text-secondary;
        }
    }
}

// The built-in assistant: a conversation, the questions waiting for the
// user, the access of the document in front, and a settings page for the
// provider, document access and MCP.
export component AssistantPanel inherits Rectangle {
    // Width when open; the caller animates the actual width.
    in property <length> panel-width: 360px;
    in property <[ChatItem]> items;
    in property <[ApprovalItem]> approvals;
    in property <bool> running;
    in property <bool> configured;
    // The document in front: its access level, -1 when there is none.
    in property <int> access-level: -1;
    in property <string> access-label;
    // 0 the conversation, 1 settings.
    in-out property <int> page;
    // Settings.
    in property <int> provider;
    in-out property <string> base-url;
    in-out property <string> model;
    in property <string> key-state;
    in property <bool> redact: true;
    in property <int> untitled-level;
    // The sidebar's folder, "" when none, and its level.
    in property <string> folder-label;
    in property <int> folder-level;
    in property <bool> mcp-enabled;
    in property <string> mcp-status;
    in property <string> mcp-clients;
    in property <[string]> mcp-client-names;
    callback disconnect-client(int);
    in property <string> mcp-setup-cli;
    in property <string> mcp-setup-json;
    // The selected provider's models, and what listing them came to.
    in property <[string]> models;
    in property <string> models-state;
    // Earlier conversations of this run, most recent first.
    in property <[string]> chats;
    in property <bool> can-insert;
    // The row of the last answer, or -1.
    in property <int> last-reply: -1;
    callback switch-chat(int);
    callback reply-action(int, int);
    // The endpoint is plain http to another computer, and whether the user
    // has allowed it anyway.
    in property <bool> insecure;
    in property <bool> allow-insecure;

    callback send(string);
    // A quick action: 0 rewrite, 1 proofread, 2 summarise, 3 continue,
    // 4 translate.
    callback quick(int);
    callback stop();
    callback new-chat();
    callback set-access(int);
    callback answer(int, int);
    callback set-provider(int);
    callback set-base-url(string);
    callback set-model(string);
    callback save-key(string);
    callback delete-key();
    callback set-redact(bool);
    callback set-untitled-level(int);
    callback set-folder-level(int);
    callback set-mcp(bool);
    callback copy(string);
    callback pick-model(string);
    callback refresh-models();
    callback settings-opened();
    callback set-allow-insecure(bool);

    background: Tokens.panel;
    clip: true;

    VHairline {
        x: 0;
    }

    // The earlier conversations, from the clock in the header.
    chat-menu := PopupWindow {
        x: root.panel-width - self.width - Tokens.space-md;
        y: 44px;
        width: 260px;
        MenuFrame { }

        VerticalLayout {
            padding: Tokens.space-xs + 2px;
            Text {
                text: Strings.ai-chats;
                font-size: Tokens.font-xs;
                color: Tokens.text-tertiary;
            }

            for title[index] in root.chats: MenuRow {
                text: title;
                clicked => {
                    root.switch-chat(index);
                }
            }
        }
    }

    // Laid out at the full width even while the panel is sliding shut.
    VerticalLayout {
        x: 1px;
        width: root.panel-width - 1px;

        // Header.
        HorizontalLayout {
            padding: Tokens.space-md;
            padding-left: Tokens.space-lg;
            spacing: Tokens.space-sm;
            VerticalLayout {
                alignment: center;
                Icon {
                    data: Icons.assistant;
                    tint: Tokens.accent;
                }
            }

            Text {
                text: root.page == 0 ? Strings.ai-title : Strings.ai-settings-title;
                font-size: Tokens.font-lg;
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.page == 0 && root.chats.length > 0: IconButton {
                icon: Icons.clock;
                accessible-role: button;
                accessible-label: Strings.ai-chats;
                clicked => {
                    chat-menu.show();
                }
            }

            if root.page == 0: IconButton {
                icon: Icons.plus;
                accessible-role: button;
                accessible-label: Strings.ai-new-chat;
                clicked => {
                    root.new-chat();
                }
            }

            if root.page == 0: TextButton {
                text: Strings.ai-settings;
                clicked => {
                    root.page = 1;
                    root.settings-opened();
                }
            }

            if root.page == 1: TextButton {
                text: Strings.ai-back;
                clicked => {
                    root.page = 0;
                }
            }
        }

        Hairline { }

        // --- The conversation -------------------------------------------
        if root.page == 0: VerticalLayout {
            vertical-stretch: 1;

            chat := Flickable {
                vertical-stretch: 1;
                content-height: max(self.height, messages.preferred-height + 2 * Tokens.space-lg);
                messages := VerticalLayout {
                    alignment: start;
                    height: self.preferred-height;
                    x: Tokens.space-lg;
                    y: Tokens.space-lg;
                    width: root.panel-width - 1px - 2 * Tokens.space-lg;
                    spacing: Tokens.space-md;
                    if root.items.length == 0: Text {
                        text: root.configured ? Strings.ai-empty : Strings.ai-not-configured;
                        font-size: Tokens.font-md;
                        color: Tokens.text-secondary;
                        wrap: word-wrap;
                    }

                    for item[row] in root.items: ChatRow {
                        item: item;
                        available: root.panel-width - 1px - 2 * Tokens.space-lg;
                        can-insert: root.can-insert;
                        last: row == root.last-reply;
                        running: root.running;
                        act(action) => {
                            root.reply-action(row, action);
                        }
                    }

                    if root.running: Text {
                        text: Strings.ai-thinking;
                        font-size: Tokens.font-sm;
                        color: Tokens.text-tertiary;
                    }
                }

                // Follow the conversation as it grows, unless the user has
                // scrolled up to read.
                changed content-height => {
                    if (self.content-y + self.content-height - self.height < 120px + messages.preferred-height - self.height) {
                        self.content-y = min(0px, self.height - self.content-height);
                    }
                }
            }

            // Questions waiting for an answer, above the input.
            for approval in root.approvals: HorizontalLayout {
                padding-left: Tokens.space-md;
                padding-right: Tokens.space-md;
                padding-bottom: Tokens.space-sm;
                ApprovalCard {
                    item: approval;
                    answer(id, choice) => {
                        root.answer(id, choice);
                    }
                }
            }

            Hairline { }

            // The document in front and what the assistant may do with it.
            VerticalLayout {
                padding: Tokens.space-md;
                padding-bottom: Tokens.space-sm;
                spacing: 6px;
                Text {
                    text: root.access-level < 0 ? Strings.ai-access-none : root.access-label;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-secondary;
                    overflow: elide;
                }

                LevelPicker {
                    level: root.access-level;
                    enabled: root.access-level >= 0;
                    picked(level) => {
                        root.set-access(level);
                    }
                }
            }

            // Quick actions: a request ready-made for the document in front.
            HorizontalLayout {
                padding-left: Tokens.space-md;
                padding-right: Tokens.space-md;
                spacing: Tokens.space-xs;
                for name[index] in [Strings.ai-quick-rewrite, Strings.ai-quick-proofread, Strings.ai-quick-summarize, Strings.ai-quick-continue, Strings.ai-quick-translate]: Rectangle {
                    property <bool> usable: root.configured && !root.running && root.access-level > 0;
                    height: 24px;
                    horizontal-stretch: 1;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Tokens.hairline;
                    background: quick-touch.has-hover && self.usable ? Tokens.hover : transparent;
                    accessible-role: button;
                    accessible-label: name;
                    Text {
                        text: name;
                        font-size: Tokens.font-sm;
                        color: parent.usable ? Tokens.text-secondary : Tokens.text-disabled;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    quick-touch := TouchArea {
                        enabled: parent.usable;
                        clicked => {
                            root.quick(index);
                        }
                    }
                }
            }

            // The prompt.
            HorizontalLayout {
                padding: Tokens.space-md;
                padding-top: Tokens.space-xs;
                spacing: Tokens.space-sm;
                Rectangle {
                    horizontal-stretch: 1;
                    height: max(2 * Tokens.control-height, min(160px, prompt.preferred-height + 2 * Tokens.space-sm));
                    border-radius: Tokens.radius-lg;
                    border-width: 1px;
                    border-color: prompt.has-focus ? Tokens.accent : Tokens.hairline;
                    background: Tokens.surface;
                    Text {
                        x: Tokens.space-md;
                        y: Tokens.space-sm;
                        width: parent.width - 2 * Tokens.space-md;
                        text: Strings.ai-input-hint;
                        visible: prompt.text == "" && !prompt.has-focus;
                        font-size: Tokens.font-md;
                        color: Tokens.text-tertiary;
                        wrap: word-wrap;
                    }

                    keys := FocusScope {
                        // Return sends; Shift+Return is a new line.
                        capture-key-pressed(event) => {
                            if (event.text == Key.Return && !event.modifiers.shift) {
                                if (!root.running && prompt.text != "" && root.configured) {
                                    root.send(prompt.text);
                                    prompt.text = "";
                                }
                                return accept;
                            }
                            return reject;
                        }
                        prompt := TextInput {
                            x: Tokens.space-md;
                            y: Tokens.space-sm;
                            width: parent.width - 2 * Tokens.space-md;
                            height: parent.height - 2 * Tokens.space-sm;
                            single-line: false;
                            wrap: word-wrap;
                            font-size: Tokens.font-md;
                            color: Tokens.text;
                            selection-background-color: Tokens.accent-soft;
                            selection-foreground-color: Tokens.text;
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    if !root.running: TextButton {
                        text: Strings.ai-send;
                        primary: true;
                        clicked => {
                            if (prompt.text != "" && root.configured) {
                                root.send(prompt.text);
                                prompt.text = "";
                            }
                        }
                    }

                    if root.running: TextButton {
                        text: Strings.ai-stop;
                        clicked => {
                            root.stop();
                        }
                    }
                }
            }
        }

        // --- Settings -----------------------------------------------------
        if root.page == 1: Flickable {
            vertical-stretch: 1;
            content-height: settings.preferred-height + 2 * Tokens.space-lg;
            settings := VerticalLayout {
                x: Tokens.space-lg;
                y: Tokens.space-lg;
                width: parent.width - 2 * Tokens.space-lg;
                spacing: Tokens.space-md;

                Section {
                    text: Strings.ai-provider;
                }

                HorizontalLayout {
                    spacing: 2px;
                    for name[index] in ["Claude", "OpenAI", "DeepSeek", Strings.provider-custom]: Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: Tokens.radius-sm;
                        background: root.provider == index ? Tokens.accent-soft : provider-touch.has-hover ? Tokens.hover : Tokens.fill;
                        Text {
                            text: name;
                            font-size: Tokens.font-sm;
                            font-weight: root.provider == index ? 600 : 400;
                            color: root.provider == index ? Tokens.accent : Tokens.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        provider-touch := TouchArea {
                            clicked => {
                                root.set-provider(index);
                            }
                        }
                    }
                }

                // The key first: with it the provider's models can be listed.
                key-field := Field {
                    label: Strings.ai-api-key + " · " + root.key-state;
                    placeholder: Strings.ai-key-hint;
                    input-type: InputType.password;
                    accepted(text) => {
                        root.save-key(text);
                        self.text = "";
                    }
                }

                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    alignment: end;
                    TextButton {
                        text: Strings.ai-key-delete;
                        clicked => {
                            root.delete-key();
                        }
                    }

                    TextButton {
                        text: Strings.ai-key-save;
                        primary: true;
                        clicked => {
                            if (key-field.text != "") {
                                root.save-key(key-field.text);
                                key-field.text = "";
                            }
                        }
                    }
                }

                Field {
                    label: Strings.ai-model;
                    text <=> root.model;
                    accepted(text) => {
                        root.set-model(text);
                    }
                }

                // The provider's models, once listed: a click picks one.
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Text {
                        text: root.models-state;
                        font-size: Tokens.font-sm;
                        color: Tokens.text-tertiary;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    TextButton {
                        text: Strings.ai-refresh-models;
                        clicked => {
                            root.refresh-models();
                        }
                    }
                }

                if root.models.length > 0: Rectangle {
                    height: min(200px, model-list.preferred-height);
                    border-radius: Tokens.radius-md;
                    border-width: 1px;
                    border-color: Tokens.hairline;
                    background: Tokens.surface;
                    clip: true;
                    Flickable {
                        content-height: model-list.preferred-height;
                        model-list := VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            for id in root.models: Rectangle {
                                height: 26px;
                                border-radius: Tokens.radius-sm;
                                background: id == root.model ? Tokens.accent-soft : model-touch.has-hover ? Tokens.hover : transparent;
                                Text {
                                    x: Tokens.space-sm;
                                    width: parent.width - 2 * Tokens.space-sm;
                                    height: parent.height;
                                    text: id;
                                    font-size: Tokens.font-sm;
                                    font-weight: id == root.model ? 600 : 400;
                                    color: id == root.model ? Tokens.accent : Tokens.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                model-touch := TouchArea {
                                    clicked => {
                                        root.pick-model(id);
                                    }
                                }
                            }
                        }
                    }
                }

                Field {
                    label: Strings.ai-base-url;
                    text <=> root.base-url;
                    accepted(text) => {
                        root.set-base-url(text);
                    }
                }

                if root.insecure: Text {
                    text: Strings.ai-insecure;
                    font-size: Tokens.font-sm;
                    color: #d1242f;
                    wrap: word-wrap;
                }

                if root.insecure: Switch {
                    label: Strings.ai-allow-insecure;
                    checked: root.allow-insecure;
                    toggled(on) => {
                        root.set-allow-insecure(on);
                    }
                }

                Switch {
                    label: Strings.ai-redact;
                    checked: root.redact;
                    toggled(on) => {
                        root.set-redact(on);
                    }
                }

                Hairline { }

                Section {
                    text: Strings.ai-access-title;
                }

                Text {
                    text: Strings.level-help;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-tertiary;
                    wrap: word-wrap;
                }

                Text {
                    text: root.folder-label == "" ? Strings.ai-no-folder : root.folder-label;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                }

                LevelPicker {
                    level: root.folder-label == "" ? -1 : root.folder-level;
                    enabled: root.folder-label != "";
                    picked(level) => {
                        root.set-folder-level(level);
                    }
                }

                Text {
                    text: Strings.ai-untitled-access;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-secondary;
                }

                LevelPicker {
                    level: root.untitled-level;
                    picked(level) => {
                        root.set-untitled-level(level);
                    }
                }

                Hairline { }

                Section {
                    text: Strings.mcp-title;
                }

                Switch {
                    label: Strings.mcp-enable;
                    checked: root.mcp-enabled;
                    toggled(on) => {
                        root.set-mcp(on);
                    }
                }

                Text {
                    text: root.mcp-status == "" ? Strings.mcp-off-note : root.mcp-status;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-tertiary;
                    wrap: word-wrap;
                }

                if root.mcp-enabled: Text {
                    text: root.mcp-clients == "" ? Strings.mcp-no-clients : root.mcp-clients;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                }

                for name[index] in root.mcp-client-names: HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Text {
                        text: name;
                        font-size: Tokens.font-sm;
                        color: Tokens.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    TextButton {
                        text: Strings.mcp-disconnect;
                        clicked => {
                            root.disconnect-client(index);
                        }
                    }
                }

                if root.mcp-setup-cli != "": Snippet {
                    label: Strings.mcp-setup-cli;
                    text: root.mcp-setup-cli;
                    copy(text) => {
                        root.copy(text);
                    }
                }

                if root.mcp-setup-json != "": Snippet {
                    label: Strings.mcp-setup-json;
                    text: root.mcp-setup-json;
                    copy(text) => {
                        root.copy(text);
                    }
                }
            }
        }
    }
}
