import { Tokens, Strings } from "tokens.slint";
import { TextButton } from "widgets.slint";

// Excel's "Move or Copy": where a sheet goes (before one of the others, or
// to the end) and whether it is copied. Return accepts, Escape cancels, Up
// and Down move through the places.
export component CopyDialog inherits Rectangle {
    in property <string> title;
    in property <string> label;
    in property <[string]> places;
    in-out property <int> selected;
    in-out property <bool> copy;
    callback confirmed();
    callback dismissed();
    background: #00000040;

    TouchArea {
        scroll-event => {
            return accept;
        }
    }

    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
            } else if (event.text == Key.Return) {
                root.confirmed();
            } else if (event.text == Key.UpArrow) {
                root.selected = max(0, root.selected - 1);
            } else if (event.text == Key.DownArrow) {
                root.selected = min(root.places.length - 1, root.selected + 1);
            }
            return accept;
        }

        Rectangle {
            width: 360px;
            height: card.preferred-height;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.hairline;
            background: Tokens.surface;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            TouchArea { }

            card := VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                Text {
                    text: root.title;
                    font-size: Tokens.font-lg;
                    font-weight: 600;
                    color: Tokens.text;
                }

                Text {
                    text: root.label;
                    font-size: Tokens.font-sm;
                    color: Tokens.text-secondary;
                }

                Rectangle {
                    height: min(root.places.length, 7) * Tokens.control-height + 2 * Tokens.space-xs;
                    border-radius: Tokens.radius-md;
                    border-width: 1px;
                    border-color: Tokens.hairline;
                    background: Tokens.sunken;
                    clip: true;
                    Flickable {
                        y: Tokens.space-xs;
                        height: parent.height - 2 * Tokens.space-xs;
                        content-height: root.places.length * Tokens.control-height;
                        for place[index] in root.places: Rectangle {
                            y: index * Tokens.control-height;
                            width: parent.width;
                            height: Tokens.control-height;
                            background: index == root.selected ? Tokens.accent-soft : (row-touch.has-hover ? Tokens.hover : transparent);
                            accessible-role: button;
                            accessible-label: place;
                            accessible-action-default => {
                                root.selected = index;
                            }
                            Text {
                                x: Tokens.space-md;
                                width: parent.width - 2 * Tokens.space-md;
                                text: place;
                                font-size: Tokens.font-md;
                                color: index == root.selected ? Tokens.accent : Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            row-touch := TouchArea {
                                clicked => {
                                    root.selected = index;
                                }
                                double-clicked => {
                                    root.selected = index;
                                    root.confirmed();
                                }
                            }
                        }
                    }
                }

                copy-row := Rectangle {
                    height: Tokens.control-height;
                    accessible-role: checkbox;
                    accessible-label: Strings.copy-make;
                    accessible-checkable: true;
                    accessible-checked: root.copy;
                    accessible-action-default => {
                        root.copy = !root.copy;
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-sm;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 3px;
                                border-width: root.copy ? 0px : 1px;
                                border-color: Tokens.text-tertiary;
                                background: root.copy ? Tokens.accent : transparent;
                                if root.copy: Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 14;
                                    viewbox-height: 14;
                                    commands: "M3.5 7.2 L6 9.6 L10.5 4.6";
                                    stroke: Tokens.on-accent;
                                    stroke-width: 1.6px;
                                    stroke-line-cap: round;
                                    stroke-line-join: round;
                                    fill: transparent;
                                }
                            }
                        }

                        Text {
                            text: Strings.copy-make;
                            font-size: Tokens.font-md;
                            color: Tokens.text;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.copy = !root.copy;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.space-sm;
                    TextButton {
                        text: Strings.button-cancel;
                        clicked => {
                            root.dismissed();
                        }
                    }

                    TextButton {
                        text: Strings.button-ok;
                        primary: true;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
