import { Tokens, Strings } from "tokens.slint";
import { TextButton } from "widgets.slint";

component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    callback accepted();
    spacing: 4px;

    public function focus-input() {
        input.focus();
        input.select-all();
    }

    Text {
        text: root.label;
        font-size: Tokens.font-sm;
        color: Tokens.text-secondary;
    }

    Rectangle {
        height: Tokens.control-height;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: input.has-focus ? Tokens.accent : Tokens.hairline;
        background: Tokens.surface;
        input := TextInput {
            x: Tokens.space-sm;
            width: parent.width - 2 * Tokens.space-sm;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            font-size: Tokens.font-md;
            color: Tokens.text;
            text <=> root.text;
            selection-background-color: Tokens.accent-soft;
            selection-foreground-color: Tokens.text;
            accepted => {
                root.accepted();
            }
        }
    }
}

// Insert or change a link or image: its text and its address. Return
// accepts, Escape cancels.
export component LinkDialog inherits Rectangle {
    in property <bool> image;
    in-out property <string> label;
    in-out property <string> address;
    callback confirmed();
    callback dismissed();
    background: #00000040;

    TouchArea {
        scroll-event => {
            return accept;
        }
    }

    FocusScope {
        init => {
            // The address is what is missing more often.
            if (root.label != "" && root.address == "") {
                address-input.focus-input();
            } else {
                label-input.focus-input();
            }
        }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 440px;
            height: card.preferred-height;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.hairline;
            background: Tokens.surface;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            TouchArea { }

            card := VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                Text {
                    text: root.image ? Strings.image-title : Strings.link-title;
                    font-size: Tokens.font-lg;
                    font-weight: 600;
                    color: Tokens.text;
                }

                label-input := LabeledInput {
                    label: root.image ? Strings.image-label : Strings.link-label;
                    text <=> root.label;
                    accepted => {
                        root.confirmed();
                    }
                }

                address-input := LabeledInput {
                    label: root.image ? Strings.image-address : Strings.link-address;
                    text <=> root.address;
                    accepted => {
                        root.confirmed();
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.space-sm;
                    TextButton {
                        text: Strings.button-cancel;
                        clicked => {
                            root.dismissed();
                        }
                    }

                    TextButton {
                        text: Strings.button-ok;
                        primary: true;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
