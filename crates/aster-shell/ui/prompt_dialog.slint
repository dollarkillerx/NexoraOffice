import { Tokens, Strings } from "tokens.slint";
import { TextButton } from "widgets.slint";
import { LabeledInput } from "link_dialog.slint";

// Ask for one line of text: a line to go to, a new name. Return accepts,
// Escape cancels.
export component PromptDialog inherits Rectangle {
    in property <string> title;
    in property <string> label;
    // Why the last entry was not taken; empty while there is nothing wrong.
    in property <string> problem;
    in-out property <string> text;
    callback confirmed();
    callback dismissed();
    background: #00000040;

    TouchArea {
        scroll-event => {
            return accept;
        }
    }

    FocusScope {
        init => {
            input.focus-input();
        }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 400px;
            height: card.preferred-height;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.hairline;
            background: Tokens.surface;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            TouchArea { }

            card := VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                Text {
                    text: root.title;
                    font-size: Tokens.font-lg;
                    font-weight: 600;
                    color: Tokens.text;
                }

                input := LabeledInput {
                    label: root.label;
                    text <=> root.text;
                    accepted => {
                        root.confirmed();
                    }
                }

                if root.problem != "": Text {
                    text: root.problem;
                    font-size: Tokens.font-sm;
                    color: Tokens.text;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.space-sm;
                    TextButton {
                        text: Strings.button-cancel;
                        clicked => {
                            root.dismissed();
                        }
                    }

                    TextButton {
                        text: Strings.button-ok;
                        primary: true;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
