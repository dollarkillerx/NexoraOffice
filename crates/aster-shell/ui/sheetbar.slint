// The chrome of a Sheets tab around the grid the Rust side draws: the
// formula bar above it (the selected cell's address and content) and the
// sheet tabs below it. Read-only: the formula bar shows, it does not edit.
// The tabs add, rename (double-click or the right-click menu), delete and
// reorder (drag) sheets when the workbook can be edited.

import { Tokens, Icons, Strings } from "tokens.slint";
import { IconButton, MenuFrame, MenuRow } from "widgets.slint";

export component FormulaBar inherits Rectangle {
    in property <string> address;
    in property <string> content;
    // A click on the content: edit the active cell there.
    callback clicked();
    height: Tokens.control-height + 2 * Tokens.space-xs;
    background: Tokens.surface;

    HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        padding-top: Tokens.space-xs;
        padding-bottom: Tokens.space-xs;
        spacing: Tokens.space-sm;

        Rectangle {
            width: 88px;
            border-radius: Tokens.radius-sm;
            background: Tokens.fill;
            Text {
                x: Tokens.space-sm;
                width: parent.width - 2 * Tokens.space-sm;
                text: root.address;
                color: Tokens.text;
                font-size: Tokens.font-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            text: "ƒx";
            color: Tokens.text-tertiary;
            font-size: Tokens.font-sm;
            font-italic: true;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: Tokens.radius-sm;
            background: Tokens.fill;
            clip: true;
            TouchArea {
                mouse-cursor: text;
                clicked => {
                    root.clicked();
                }
            }
            Text {
                x: Tokens.space-sm;
                width: parent.width - 2 * Tokens.space-sm;
                text: root.content;
                color: Tokens.text;
                font-size: Tokens.font-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.hairline;
    }
}

export component SheetBar inherits Rectangle {
    in property <[string]> names;
    in property <int> current;
    // Sheets can be added, renamed and deleted.
    in property <bool> editable;
    callback selected(int);
    callback add();
    callback rename(int);
    callback delete(int);
    callback move-copy(int);
    // A tab was dragged from one place to another (as shown).
    callback moved(int, int);
    // A tab being dragged, where the pointer is along the tabs, and the tab
    // it would land on.
    property <int> drag-from: -1;
    property <length> drag-x;
    property <int> drop-index: -1;
    // The press that ends now was a drag, not a click.
    property <bool> was-dragged;
    // The tab the right-click menu is for, and where it was clicked.
    property <int> menu-for: -1;
    property <length> menu-x;
    height: Tokens.control-height + 2 * Tokens.space-xs;
    background: Tokens.panel;

    Rectangle {
        height: 1px;
        y: 0;
        background: Tokens.hairline;
    }

    add-button := IconButton {
        x: parent.width - self.width - Tokens.space-sm;
        y: (parent.height - self.height) / 2;
        visible: root.editable;
        icon: Icons.plus;
        size: Tokens.control-height - 4px;
        accessible-role: button;
        accessible-label: Strings.sheet-add;
        clicked => {
            root.add();
        }
    }

    Flickable {
        x: Tokens.space-sm;
        width: parent.width - 2 * Tokens.space-sm - (root.editable ? add-button.width + Tokens.space-sm : 0px);
        content-width: max(self.width, tabs.preferred-width);
        tabs := HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-xs;
            padding-top: Tokens.space-xs;
            padding-bottom: Tokens.space-xs;
            for name[index] in root.names: tab := Rectangle {
                property <bool> active: index == root.current;
                property <bool> drop-here: root.drag-from >= 0 && root.drag-x >= self.x && root.drag-x < self.x + self.width;
                changed drop-here => {
                    if (self.drop-here) {
                        root.drop-index = index;
                    }
                }
                height: Tokens.control-height;
                border-radius: Tokens.radius-sm;
                background: self.active ? Tokens.surface : touch.has-hover ? Tokens.hover : transparent;
                border-width: self.active ? 1px : 0px;
                border-color: Tokens.hairline;
                HorizontalLayout {
                    padding-left: Tokens.space-md;
                    padding-right: Tokens.space-md;
                    label := Text {
                        text: name;
                        color: tab.active ? Tokens.accent : Tokens.text-secondary;
                        font-size: Tokens.font-sm;
                        font-weight: tab.active ? 600 : 400;
                        vertical-alignment: center;
                    }
                }
                // Where the dragged tab would go: before this one, or after it.
                if tab.drop-here && root.drag-from != index: Rectangle {
                    x: index < root.drag-from ? 0px : parent.width - self.width;
                    width: 2px;
                    background: Tokens.accent;
                }

                touch := TouchArea {
                    clicked => {
                        if (!root.was-dragged) {
                            root.selected(index);
                        }
                    }
                    moved => {
                        if (self.pressed && root.editable && abs(self.mouse-x - self.pressed-x) > 8px) {
                            root.was-dragged = true;
                            root.drag-from = index;
                            root.drag-x = tab.x + self.mouse-x;
                        }
                    }
                    double-clicked => {
                        if (root.editable) {
                            root.rename(index);
                        }
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.was-dragged = false;
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-from == index) {
                            if (root.drop-index >= 0 && root.drop-index != index) {
                                root.moved(index, root.drop-index);
                            }
                            root.drag-from = -1;
                            root.drop-index = -1;
                        }
                        if (root.editable && event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                            root.selected(index);
                            root.menu-for = index;
                            root.menu-x = tab.absolute-position.x - root.absolute-position.x + touch.mouse-x;
                            menu.show();
                        }
                    }
                }
            }
        }
    }

    // Above the bar: it sits at the bottom of the window.
    menu := PopupWindow {
        x: max(Tokens.space-sm, min(root.menu-x, root.width - self.width - Tokens.space-sm));
        y: -items.preferred-height - Tokens.space-xs;
        width: max(160px, items.preferred-width);
        MenuFrame { }

        items := VerticalLayout {
            padding: Tokens.space-xs + 2px;
            spacing: 1px;
            MenuRow {
                text: Strings.sheet-rename;
                clicked => {
                    root.rename(root.menu-for);
                }
            }

            MenuRow {
                text: Strings.sheet-move-copy;
                clicked => {
                    root.move-copy(root.menu-for);
                }
            }

            MenuRow {
                text: Strings.sheet-delete;
                enabled: root.names.length > 1;
                clicked => {
                    root.delete(root.menu-for);
                }
            }
        }
    }
}
