import { Tokens, Strings } from "tokens.slint";
import { TextButton } from "widgets.slint";
import { LabeledInput } from "link_dialog.slint";

// Split a cell of a table in a Word document: into how many columns and
// rows. Return accepts, Escape cancels. The fields are text; the Rust side
// reads the numbers and asks the view whether the split is possible.
export component SplitDialog inherits Rectangle {
    in-out property <string> rows;
    in-out property <string> columns;
    callback confirmed();
    callback dismissed();
    background: #00000040;

    TouchArea {
        scroll-event => {
            return accept;
        }
    }

    FocusScope {
        init => {
            rows-input.focus-input();
        }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 320px;
            height: card.preferred-height;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.hairline;
            background: Tokens.surface;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000040;
            TouchArea { }

            card := VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                Text {
                    text: Strings.split-dialog-title;
                    font-size: Tokens.font-lg;
                    font-weight: 600;
                    color: Tokens.text;
                }

                HorizontalLayout {
                    spacing: Tokens.space-md;
                    rows-input := LabeledInput {
                        label: Strings.table-rows;
                        text <=> root.rows;
                        accepted => {
                            root.confirmed();
                        }
                    }

                    columns-input := LabeledInput {
                        label: Strings.table-columns;
                        text <=> root.columns;
                        accepted => {
                            root.confirmed();
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Tokens.space-sm;
                    TextButton {
                        text: Strings.button-cancel;
                        clicked => {
                            root.dismissed();
                        }
                    }

                    TextButton {
                        text: Strings.button-ok;
                        primary: true;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
