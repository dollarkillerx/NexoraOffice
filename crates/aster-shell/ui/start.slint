import { Tokens, Icons, Strings, KindItem, RecentItem } from "tokens.slint";
import { Icon, KindGlyph, AsterMark, Badge, Hairline, TextButton, MenuFrame, RecentMenuItems } from "widgets.slint";

component KindTile inherits Rectangle {
    in property <KindItem> item;
    callback clicked;
    height: 148px;
    min-width: 112px;
    horizontal-stretch: 1;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: touch.has-hover ? Tokens.accent : Tokens.hairline;
    background: touch.pressed ? Tokens.accent-soft : touch.has-hover ? Tokens.fill : transparent;
    animate background, border-color { duration: Tokens.quick; }

    KindGlyph {
        x: Tokens.space-lg;
        y: Tokens.space-lg;
        kind: root.item.kind;
        size: 32px;
        ink: touch.has-hover ? Tokens.accent : Tokens.text;
        animate ink { duration: Tokens.quick; }
    }

    if !root.item.implemented: Badge {
        x: parent.width - self.width - Tokens.space-md;
        y: Tokens.space-md;
        text: Strings.placeholder;
    }

    Text {
        x: Tokens.space-lg;
        y: parent.height - 72px;
        width: parent.width - 2 * Tokens.space-lg;
        text: root.item.name;
        font-size: Tokens.font-lg;
        font-weight: 600;
        color: Tokens.text;
    }

    // Two lines: the taglines of some languages do not fit on one.
    Text {
        x: Tokens.space-lg;
        y: parent.height - 49px;
        width: parent.width - 2 * Tokens.space-lg;
        height: 34px;
        text: root.item.tagline;
        font-size: Tokens.font-sm;
        color: Tokens.text-secondary;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component RecentRow inherits Rectangle {
    in property <RecentItem> item;
    callback clicked;
    callback reveal;
    callback remove;
    callback clear;
    height: 40px;
    border-radius: Tokens.radius-md;
    background: touch.pressed ? Tokens.pressed : touch.has-hover ? Tokens.hover : transparent;
    animate background { duration: Tokens.quick; }
    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        spacing: Tokens.space-md;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            KindGlyph {
                kind: root.item.kind;
                ink: root.item.missing ? Tokens.text-disabled : Tokens.text-secondary;
            }
        }

        Text {
            text: root.item.title;
            font-size: Tokens.font-md;
            color: root.item.missing ? Tokens.text-disabled : Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
            // The name matters more than the folder, which can be long.
            min-width: min(self.preferred-width, 240px);
        }

        Text {
            text: root.item.location;
            font-size: Tokens.font-sm;
            color: Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }

        Text {
            text: root.item.missing ? Strings.recent-missing : root.item.opened;
            font-size: Tokens.font-sm;
            color: Tokens.text-tertiary;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 0;
            min-width: 76px;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: touch.mouse-x + 2px;
        y: touch.mouse-y + 2px;
        width: max(200px, items.preferred-width);
        MenuFrame { }

        items := RecentMenuItems {
            missing: root.item.missing;
            reveal => {
                root.reveal();
            }
            remove => {
                root.remove();
            }
            clear => {
                root.clear();
            }
        }
    }
}

// Shown when no document is in front: one tile per editor and the recent files.
export component StartPage inherits Rectangle {
    in property <[KindItem]> kinds;
    in property <[RecentItem]> recent;
    callback new-document(int);
    callback open-recent(int);
    callback reveal-recent(int);
    callback remove-recent(int);
    callback clear-recent();
    callback open-file();
    callback open-folder();
    background: Tokens.surface;

    Flickable {
        content-height: max(self.height, column.preferred-height);
        column := VerticalLayout {
            y: 0;
            x: max(Tokens.space-xl, (parent.width - self.width) / 2);
            width: min(parent.width - 2 * Tokens.space-xl, 820px);
            alignment: start;
            padding-top: 56px;
            padding-bottom: Tokens.space-xl;
            spacing: 0px;

            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-md;
                AsterMark {
                    size: 48px;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Aster Office";
                        font-size: Tokens.font-display;
                        font-weight: 600;
                        color: Tokens.text;
                    }

                    Text {
                        text: Strings.tagline;
                        font-size: Tokens.font-md;
                        color: Tokens.text-secondary;
                    }
                }
            }

            Rectangle {
                height: 40px;
            }

            Text {
                text: Strings.new-document;
                font-size: Tokens.font-sm;
                font-weight: 600;
                color: Tokens.text-secondary;
                height: 28px;
            }

            HorizontalLayout {
                spacing: Tokens.space-md;
                for entry in root.kinds: KindTile {
                    item: entry;
                    clicked => {
                        root.new-document(entry.kind);
                    }
                }
            }

            Rectangle {
                height: Tokens.space-lg;
            }

            // Opens a real file from disk, in a Markdown tab, or a folder in
            // the sidebar.
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-sm;
                TextButton {
                    text: Strings.open-file;
                    icon: Icons.folder-open;
                    clicked => {
                        root.open-file();
                    }
                }

                TextButton {
                    text: Strings.menu-open-folder;
                    icon: Icons.folder;
                    clicked => {
                        root.open-folder();
                    }
                }
            }

            Rectangle {
                height: 28px;
            }

            HorizontalLayout {
                height: 28px;
                spacing: Tokens.space-sm;
                alignment: start;
                Text {
                    text: Strings.recent;
                    font-size: Tokens.font-sm;
                    font-weight: 600;
                    color: Tokens.text-secondary;
                }
            }

            Hairline { }

            Rectangle {
                height: Tokens.space-xs;
            }

            if root.recent.length == 0: Text {
                height: 40px;
                text: Strings.recent-empty;
                font-size: Tokens.font-sm;
                color: Tokens.text-tertiary;
                vertical-alignment: center;
            }

            for item[index] in root.recent: RecentRow {
                item: item;
                clicked => {
                    root.open-recent(index);
                }
                reveal => {
                    root.reveal-recent(index);
                }
                remove => {
                    root.remove-recent(index);
                }
                clear => {
                    root.clear-recent();
                }
            }
        }
    }
}
