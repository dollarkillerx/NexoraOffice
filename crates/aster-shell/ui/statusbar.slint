import { Tokens, Icons } from "tokens.slint";
import { IconButton, Hairline } from "widgets.slint";

component StatusText inherits Text {
    font-size: Tokens.font-sm;
    color: Tokens.text-secondary;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

component Dot inherits StatusText {
    text: "·";
    color: Tokens.text-tertiary;
}

export component StatusBar inherits Rectangle {
    in property <string> kind-label;
    // Says what the view really is, e.g. that it is a placeholder.
    in property <string> note;
    // Already worded, e.g. "125 字". Empty when the view has no text to count.
    in property <string> words;
    in property <string> chars;
    // Encoding and line endings of the file, e.g. "UTF-8 · CRLF". Empty when
    // the view is not a file.
    in property <string> file-format;
    // Something the user should know before saving. Empty most of the time.
    in property <string> notice;
    in property <string> ime-label;
    in property <bool> ime-composing;
    in property <string> zoom-label;
    in property <bool> zoom-enabled;
    callback zoom-out();
    callback zoom-reset();
    callback zoom-in();
    height: Tokens.status-bar-height;
    background: Tokens.panel;

    Hairline {
            y: 0;
        }

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-sm;

        StatusText {
            text: root.kind-label;
            color: Tokens.text;
        }

        if root.note != "": Dot { }
        if root.note != "": StatusText {
            text: root.note;
        }
        if root.words != "": Dot { }
        if root.words != "": StatusText {
            text: root.words;
        }
        if root.chars != "": Dot { }
        if root.chars != "": StatusText {
            text: root.chars;
        }

        if root.notice != "": Dot { }
        if root.notice != "": StatusText {
            text: root.notice;
            color: Tokens.text;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.file-format != "": StatusText {
            text: root.file-format;
        }

        if root.ime-label != "": HorizontalLayout {
            spacing: Tokens.space-xs + 2px;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.ime-composing ? Tokens.accent : Tokens.text-tertiary;
                }
            }

            StatusText {
                text: root.ime-label;
            }
        }

        if root.zoom-label != "": HorizontalLayout {
            spacing: 0px;
            horizontal-stretch: 0;
            padding-left: Tokens.space-sm;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.minus;
                    size: 20px;
                    icon-size: 12px;
                    enabled: root.zoom-enabled;
                    clicked => {
                        root.zoom-out();
                    }
                }
            }

            Rectangle {
                width: 44px;
                border-radius: Tokens.radius-sm;
                background: root.zoom-enabled && zoom-touch.has-hover ? Tokens.hover : transparent;
                StatusText {
                    width: 100%;
                    height: 100%;
                    text: root.zoom-label;
                    horizontal-alignment: center;
                    color: root.zoom-enabled ? Tokens.text-secondary : Tokens.text-disabled;
                }

                zoom-touch := TouchArea {
                    enabled: root.zoom-enabled;
                    clicked => {
                        root.zoom-reset();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.plus;
                    size: 20px;
                    icon-size: 12px;
                    enabled: root.zoom-enabled;
                    clicked => {
                        root.zoom-in();
                    }
                }
            }
        }
    }
}
