// Design tokens as the UI sees them. The values are written once, in
// src/theme.rs and src/icons.rs, and copied in at start-up and whenever the
// theme changes. Nothing in ui/ may use a colour, length or font size that is
// not one of these.

export global Tokens {
    in property <bool> dark;

    in property <color> surface;
    in property <color> sunken;
    in property <color> panel;
    in property <color> fill;
    in property <color> hover;
    in property <color> pressed;
    in property <color> hairline;
    in property <color> text;
    in property <color> text-secondary;
    in property <color> text-tertiary;
    in property <color> text-disabled;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> accent-soft;
    in property <color> desk;
    in property <color> page;
    in property <color> page-edge;

    in property <length> space-xs;
    in property <length> space-sm;
    in property <length> space-md;
    in property <length> space-lg;
    in property <length> space-xl;
    in property <length> radius-sm;
    in property <length> radius-md;
    in property <length> radius-lg;
    in property <length> control-height;
    in property <length> tab-strip-height;
    in property <length> toolbar-height;
    in property <length> status-bar-height;
    in property <length> sidebar-width;
    in property <length> icon-size;
    in property <length> font-xs;
    in property <length> font-sm;
    in property <length> font-md;
    in property <length> font-lg;
    in property <length> font-xl;
    in property <length> font-display;

    // How long a hover or selection change takes to settle.
    out property <duration> quick: 90ms;
}

