// Path data for the icons the chrome itself uses. Toolbar icons arrive with the
// toolbar model instead.
export global Icons {
    in property <string> close;
    in property <string> plus;
    in property <string> minus;
    in property <string> chevron-down;
    in property <string> chevron-right;
    in property <string> sidebar;
    in property <string> sun;
    in property <string> moon;
    in property <string> folder;
    in property <string> clock;
    in property <string> search;
    in property <string> globe;
    in property <string> assistant;
    in property <string> check;
    in property <string> folder-open;
    in property <string> chevron-up;
    in property <string> refresh;
}

export struct TabItem {
    title: string,
    // The document has unsaved changes.
    modified: bool,
    // Index into the document kinds: 0 Writer, 1 Sheets, 2 Slides, 3 Markdown, 4 PDF.
    kind: int,
}

export struct ToolItem {
    // 0 icon button, 1 letter button, 2 select, 3 value, 4 separator, 5 spacer.
    control: int,
    icon: string,
    text: string,
    width: length,
    bold: bool,
    italic: bool,
    underline: bool,
    strike: bool,
    enabled: bool,
    // Shown pressed: the choice in effect.
    active: bool,
    command: int,
    // A select field: what its list offers, in order.
    options: [string],
}

export struct KindItem {
    kind: int,
    name: string,
    tagline: string,
    // False for the kinds that only open a placeholder.
    implemented: bool,
}

export struct RecentItem {
    title: string,
    kind: int,
    location: string,
    opened: string,
    // The file was not there when last looked for.
    missing: bool,
}

export struct TreeItem {
    // The entry's name, or for a note what it says.
    name: string,
    depth: int,
    // A document kind as in TabItem; -1 folder, -2 link to a folder above
    // it, -3 a note about the folder above (reading, empty, cannot be read).
    kind: int,
    expanded: bool,
    // Files only: this version can open it.
    opens: bool,
    // The document in front.
    current: bool,
    // Notes only: something went wrong.
    problem: bool,
}

// One document the recovery question offers.
export struct RecoveryItem {
    title: string,
    // The file it belongs to, or that it was never saved.
    detail: string,
    // How long ago it was last edited.
    age: string,
    // What became of its file, or why the record cannot be read.
    note: string,
    // False when the record cannot be read: it can only be discarded.
    readable: bool,
}

// One entry in the assistant's conversation.
export struct ChatItem {
    // 0 the user, 1 the assistant, 2 a tool call, 3 an error, 4 a notice.
    kind: int,
    text: string,
    // Tool calls: the document or target, shown after the tool's name.
    detail: string,
    // Tool calls: 0 running, 1 done, 2 failed.
    state: int,
}

// A question waiting for the user: may the assistant or an MCP client do
// this?
export struct ApprovalItem {
    id: int,
    // "The assistant wants to change “notes.md”".
    title: string,
    // The tool, and who asked.
    detail: string,
    // What it does, in a line: which lines, what is searched for.
    facts: string,
    // The text it would replace or delete, shortened; "" for none.
    removed: string,
    // The text it would write, shortened.
    preview: string,
}

// A heading in the sidebar's outline.
// An encoding a file can be read in, and how its start reads in it.
export struct EncodingChoice {
    label: string,
    preview: string,
}

export struct OutlineItem {
    level: int,
    text: string,
    // The heading the caret is under.
    current: bool,
}
