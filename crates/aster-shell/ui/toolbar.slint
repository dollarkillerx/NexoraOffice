import { Tokens, Icons, ToolItem } from "tokens.slint";
import { Icon, MenuRow, MenuFrame } from "widgets.slint";

component ToolControl inherits Rectangle {
    in property <ToolItem> item;
    callback activated;
    // An entry of a select field's list was chosen.
    callback chosen(int);
    property <bool> is-button: item.control == 0 || item.control == 1 || item.control == 6;
    property <bool> is-gap: item.control == 4 || item.control == 5;
    property <length> fixed-width: is-button ? Tokens.control-height : item.control == 4 ? 9px : item.control == 5 ? 0px : item.width;
    property <brush> ink: item.enabled ? Tokens.text : Tokens.text-disabled;
    min-width: fixed-width;
    max-width: item.control == 5 ? 100000px : fixed-width;
    horizontal-stretch: item.control == 5 ? 1 : 0;
    height: Tokens.control-height;

    Rectangle {
        border-radius: Tokens.radius-md;
        background: root.is-gap || !root.item.enabled ? transparent : touch.pressed ? Tokens.pressed : root.item.active ? Tokens.accent-soft : touch.has-hover ? Tokens.hover : transparent;
        animate background { duration: Tokens.quick; }
    }

    if item.control == 0: Icon {
        data: root.item.icon;
        tint: !root.item.enabled ? Tokens.text-disabled : root.item.active ? Tokens.accent : Tokens.text-secondary;
    }

    if item.control == 1: Text {
        text: root.item.text;
        font-size: Tokens.font-lg - 1px;
        font-weight: root.item.bold ? 700 : 500;
        font-italic: root.item.italic;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // A colour button: its face, raised a little, over a bar of the colour.
    if item.control == 6 && item.icon != "": Icon {
        y: -2px;
        data: root.item.icon;
        tint: root.item.enabled ? Tokens.text-secondary : Tokens.text-disabled;
    }

    if item.control == 6 && item.icon == "": Text {
        y: -2px;
        height: parent.height;
        text: root.item.text;
        font-size: Tokens.font-lg - 1px;
        font-weight: 500;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if item.control == 6: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 7px;
        width: 14px;
        height: 3px;
        border-radius: 1px;
        background: root.item.has-swatch ? root.item.swatch : transparent;
        border-width: root.item.has-swatch ? 0px : 1px;
        border-color: Tokens.hairline;
    }

    if item.control == 1 && item.underline: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 6px;
        width: 11px;
        height: 1.5px;
        background: root.ink;
    }

    if item.control == 1 && item.strike: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height / 2;
        width: 13px;
        height: 1.5px;
        background: root.ink;
    }

    if item.control == 2: HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-xs;
        spacing: 2px;
        Text {
            text: root.item.text;
            font-size: Tokens.font-md;
            color: root.ink;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon {
                data: Icons.chevron-down;
                size: 14px;
                tint: root.item.enabled ? Tokens.text-tertiary : Tokens.text-disabled;
            }
        }
    }

    if item.control == 3: Text {
        text: root.item.text;
        font-size: Tokens.font-md;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if item.control == 4: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: 16px;
        background: Tokens.hairline;
    }

    touch := TouchArea {
        enabled: root.item.enabled && !root.is-gap;
        clicked => {
            if (root.item.control == 6) {
                palette.show();
            } else if (root.item.options.length > 0) {
                options.show();
            } else {
                root.activated();
            }
        }
    }

    // A select field with a list opens it under itself. Drawn by Slint
    // rather than as a native menu: a native menu opened from a click runs
    // its own event loop inside winit's handler, and winit panics on the
    // next event.
    // A colour button's palette: "none" (or "automatic"), then the colours
    // eight to a row.
    palette := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 8 * 24px + 2 * (Tokens.space-xs + 2px);
        MenuFrame { }

        VerticalLayout {
            padding: Tokens.space-xs + 2px;
            spacing: 4px;
            for option[index] in root.item.options: MenuRow {
                text: option;
                checked: !root.item.has-swatch;
                clicked => {
                    root.chosen(0);
                }
            }

            Rectangle {
                height: ceil(root.item.colours.length / 8) * 24px;
                for colour[index] in root.item.colours: Rectangle {
                    x: mod(index, 8) * 24px + 2px;
                    y: floor(index / 8) * 24px + 2px;
                    width: 20px;
                    height: 20px;
                    border-radius: 3px;
                    background: colour;
                    border-width: (root.item.has-swatch && root.item.swatch == colour) ? 2px : 1px;
                    border-color: (root.item.has-swatch && root.item.swatch == colour) ? Tokens.accent : Tokens.hairline;
                    TouchArea {
                        clicked => {
                            root.chosen(index + 1);
                        }
                    }
                }
            }
        }
    }

    options := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 132px);
        MenuFrame { }

        VerticalLayout {
            padding: Tokens.space-xs + 2px;
            spacing: 1px;
            for option[index] in root.item.options: MenuRow {
                text: option;
                checked: option == root.item.text;
                clicked => {
                    root.chosen(index);
                }
            }
        }
    }
}

// The single-row toolbar: one capsule, groups divided by thin rules.
export component Toolbar inherits Rectangle {
    in property <[ToolItem]> items;
    callback command(int);
    // An entry of a select field's list: the field's command, the index.
    callback option(int, int);
    height: Tokens.toolbar-height + 2 * Tokens.space-xs + 2px;
    background: Tokens.surface;

    // Sized by hand rather than by a layout, so that a toolbar wider than the
    // window is clipped instead of forcing the window to grow.
    Rectangle {
        x: Tokens.space-sm;
        y: Tokens.space-xs + 1px;
        width: parent.width - 2 * Tokens.space-sm;
        height: Tokens.toolbar-height;
        border-radius: self.height / 2;
        background: Tokens.fill;
        clip: true;
        HorizontalLayout {
            x: 0;
            width: max(parent.width, self.min-width);
            padding-left: Tokens.space-md;
            padding-right: Tokens.space-md;
            spacing: 1px;
            for item in root.items: VerticalLayout {
                alignment: center;
                horizontal-stretch: item.control == 5 ? 1 : 0;
                ToolControl {
                    item: item;
                    activated => {
                        root.command(item.command);
                    }
                    chosen(index) => {
                        root.option(item.command, index);
                    }
                }
            }
        }
    }
}
