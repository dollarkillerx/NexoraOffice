// Phase 0 gate G1: the shell. Everything below the header is one image that the
// Rust side draws itself; Slint only forwards input to it.

export component AppWindow inherits Window {
    title: "G1 · 自绘表面内的输入法";
    // Window and taskbar icon on Windows and X11. macOS takes the Dock icon from
    // the bundle and Wayland from the desktop entry, so this does nothing there.
    icon: @image-url("../../../assets/brand/logo/png/aster-icon-256.png");
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 480px;
    min-height: 320px;
    background: #ffffff;
    forward-focus: scope;

    // The frame the Rust side rendered for the document surface.
    in property <image> frame;
    // One-line summaries shown in the header and the footer.
    in property <string> ime-summary: "输入法：尚未收到事件";
    in property <string> last-event: "点一下下面的白色区域，然后切到中文或日文输入法打字";

    // Geometry the Rust side needs to size its buffer and place the candidate window.
    out property <length> surface-width: surface.width;
    out property <length> surface-height: surface.height;
    out property <length> surface-x: surface.absolute-position.x;
    out property <length> surface-y: surface.absolute-position.y;
    out property <bool> surface-focused: scope.has-focus;

    // text, shift, primary (Cmd on macOS, Ctrl elsewhere), alt. Returns true when handled.
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback pointer-down(length, length, bool);
    callback pointer-drag(length, length);

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                Text {
                    text: "G1 输入法关卡";
                    font-size: 14px;
                    font-weight: 600;
                    color: #0b0b0b;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                Text {
                    text: root.ime-summary;
                    font-size: 13px;
                    color: #555555;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #0000001f;
        }

        surface := Rectangle {
            background: #f1f1f0;
            vertical-stretch: 1;

            Image {
                source: root.frame;
                width: 100%;
                height: 100%;
                image-fit: fill;
            }

            scope := FocusScope {
                key-pressed(event) => {
                    return root.key-pressed(event.text, event.modifiers.shift, event.modifiers.control, event.modifiers.alt) ? accept : reject;
                }

                TouchArea {
                    mouse-cursor: text;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            scope.focus();
                            root.pointer-down(self.mouse-x, self.mouse-y, event.modifiers.shift);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.pointer-drag(self.mouse-x, self.mouse-y);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #0000001f;
        }

        Rectangle {
            height: 30px;
            background: #f7f7f6;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: root.last-event;
                    font-size: 12px;
                    color: #555555;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
